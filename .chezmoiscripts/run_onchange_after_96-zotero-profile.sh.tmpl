{{- if has "research" (index .machines .machine).bundles -}}
#!/usr/bin/env bash
# Zotero owns its profile. Do not overwrite an existing user.js or edit prefs.js.
#
# Re-runs when shared preferences, Better BibTeX pin, Extra Meta source, Zotero
# profile presence, or a deferred (Zotero-running) pending marker changes.
# zotero-user.js sha256: {{ include "private_dot_config/dotfiles/zotero-user.js.tmpl" | sha256sum }}
# better-bibtex tag: {{ (index .downloads "better-bibtex").tag }}
# better-bibtex downloaded: {{ if stat (joinPath .chezmoi.homeDir ".local/opt/dotfiles/better-bibtex/current/better-bibtex.xpi") }}present{{ else }}absent{{ end }}
# extra-meta sha256: {{ range (glob (joinPath .chezmoi.sourceDir "zotero/extra-meta/**")) }}{{ if not (stat .).isDir }}{{ include . | sha256sum }}{{ end }}{{ end }}
# profiles.ini: {{ if stat (joinPath .chezmoi.homeDir ".zotero/zotero/profiles.ini") }}present{{ else }}absent{{ end }}
# pending: {{ $pending := joinPath .chezmoi.homeDir ".local/state/dotfiles/zotero-pending" }}{{ if stat $pending }}{{ include $pending | trim }}{{ else }}none{{ end }}
set -eu

if ! command -v python3 >/dev/null 2>&1; then
    echo "zotero setup: python3 not found; retry with chezmoi apply" >&2
    exit 0
fi

exec python3 - <<'PY'
from configparser import ConfigParser, Error
import fcntl
import hashlib
import io
import json
import os
from pathlib import Path
import re
import shutil
import sys
import tempfile
import time
from zipfile import BadZipFile, ZIP_DEFLATED, ZipFile, ZipInfo

home = Path.home()
zotero = home / ".zotero/zotero"
shared = home / ".config/dotfiles/zotero-user.js"
bbt_plugin = home / ".local/opt/dotfiles/better-bibtex/current/better-bibtex.xpi"
bbt_tag = {{ (index .downloads "better-bibtex").tag | quote }}
extra_meta_source = Path({{ joinPath .chezmoi.sourceDir "zotero/extra-meta" | quote }})
pending_marker = home / ".local/state/dotfiles/zotero-pending"
MAX_BACKUPS = 5
deferred = False


def warn(message):
    print(f"zotero setup: {message}", file=sys.stderr)


def mark_deferred():
    global deferred
    deferred = True


def digest(source):
    if isinstance(source, bytes):
        return hashlib.sha256(source).hexdigest()
    h = hashlib.sha256()
    with source.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def parse_version(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)*", value):
        raise ValueError("invalid plugin version")
    return tuple(map(int, value.split(".")))


def metadata(source, expected_id):
    archive = io.BytesIO(source) if isinstance(source, bytes) else source
    with ZipFile(archive) as package:
        manifest = json.loads(package.read("manifest.json"))
    if manifest["applications"]["zotero"]["id"] != expected_id:
        raise ValueError("unexpected plugin ID")
    version_str = manifest["version"]
    return parse_version(version_str), version_str


def collect_plugin_files(source_dir):
    if source_dir.is_symlink():
        raise ValueError("plugin source directory must not be a symlink")
    files = []
    for name in ("manifest.json", "bootstrap.js"):
        path = source_dir / name
        if path.is_symlink():
            raise ValueError(f"symlink not allowed in plugin source: {name}")
        if path.is_file():
            files.append(path)
    for dirname in ("content", "locale"):
        root = source_dir / dirname
        if root.is_symlink():
            raise ValueError(f"symlink not allowed in plugin source: {dirname}")
        if not root.is_dir():
            continue
        for entry in root.rglob("*"):
            rel_parts = entry.relative_to(source_dir).parts
            if any(part.startswith(".") for part in rel_parts):
                continue
            if entry.is_symlink():
                raise ValueError(f"symlink not allowed in plugin source: {entry.relative_to(source_dir).as_posix()}")
            if entry.is_file():
                files.append(entry)
    return sorted(files)


def build_xpi(source_dir):
    files = collect_plugin_files(source_dir)
    if not files:
        raise ValueError("plugin source directory is empty")
    buffer = io.BytesIO()
    with ZipFile(buffer, "w") as package:
        for file_path in files:
            rel = file_path.relative_to(source_dir).as_posix()
            info = ZipInfo(rel, date_time=(2026, 1, 1, 0, 0, 0))
            info.compress_type = ZIP_DEFLATED
            info.create_system = 3
            info.external_attr = 0o100644 << 16
            package.writestr(info, file_path.read_bytes())
    return buffer.getvalue()


def prune_backups(backup_dir):
    backups = sorted(
        (p for p in backup_dir.glob("*.xpi") if p.is_file() and not p.is_symlink()),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    for stale in backups[MAX_BACKUPS:]:
        stale.unlink(missing_ok=True)


def preferences(profile):
    if not shared.is_file():
        warn("shared preferences missing; retry with chezmoi apply")
        mark_deferred()
        return
    user_js = profile / "user.js"
    try:
        if user_js.is_symlink() and user_js.resolve() == shared.resolve():
            return
        if user_js.exists() or user_js.is_symlink():
            warn(f"{user_js} already exists; left it unchanged")
            return
        user_js.symlink_to(shared)
        print(f"zotero setup: linked {user_js}; restart Zotero to load it")
    except OSError as error:
        warn(f"cannot link {user_js} ({error}); retry with chezmoi apply")
        mark_deferred()


def addon_status(profile, plugin_id, name, check_updates):
    try:
        addons = json.loads((profile / "extensions.json").read_text())["addons"]
        addon = next((entry for entry in addons if entry.get("id") == plugin_id), None)
        if addon and not addon.get("active"):
            warn(f"enable {name} in Zotero if the plugin is disabled")
        if check_updates and addon and str(addon.get("applyBackgroundUpdates")) != "0":
            warn(f"set automatic updates to Off for {name} in Zotero")
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass


def install_plugin(profile, plugin_id, name, source, expected_version=None, check_updates=False):
    try:
        actual_version, version_str = metadata(source, plugin_id)
        if expected_version is not None and actual_version != parse_version(expected_version):
            raise ValueError("package version does not match the catalog pin")
        wanted = digest(source)
        target = profile / "extensions" / f"{plugin_id}.xpi"
        if target.is_symlink():
            warn(f"{target} is a symlink; left it unchanged")
            return
        if target.exists() and digest(target) == wanted:
            addon_status(profile, plugin_id, name, check_updates)
            return
        # Firefox holds a POSIX lock on this file for the life of the profile.
        # Hold the same lock until the copy is complete, including backup.
        with (profile / ".parentlock").open("a") as lock:
            try:
                fcntl.lockf(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                warn(f"close Zotero and run chezmoi apply to install {name}")
                mark_deferred()
                return
            if target.is_symlink():
                warn(f"{target} is a symlink; left it unchanged")
                return
            if target.exists():
                if metadata(target, plugin_id)[0] > actual_version:
                    warn(f"installed {name} is newer than the pin; downgrade skipped")
                    return
                old_hash = digest(target)
                backup_dir = home / ".local/state/dotfiles/zotero-plugins"
                backup = backup_dir / f"{old_hash}.xpi"
                backup_dir.mkdir(parents=True, exist_ok=True)
                if backup.exists() and digest(backup) != old_hash:
                    raise ValueError("existing plugin backup has an unexpected hash")
                if not backup.exists():
                    shutil.copy2(target, backup)
                if digest(backup) != old_hash:
                    raise ValueError("plugin backup verification failed")
                prune_backups(backup_dir)
            target.parent.mkdir(parents=True, exist_ok=True)
            fd, temporary = tempfile.mkstemp(prefix=f".{plugin_id}-", dir=target.parent)
            os.close(fd)
            try:
                if isinstance(source, bytes):
                    Path(temporary).write_bytes(source)
                else:
                    shutil.copy2(source, temporary)
                os.chmod(temporary, 0o644)
                if digest(Path(temporary)) != wanted:
                    raise ValueError("plugin copy verification failed")
                os.replace(temporary, target)
            finally:
                Path(temporary).unlink(missing_ok=True)
        print(f"zotero setup: installed {name} {version_str}; start Zotero to load it")
        if check_updates:
            print(f"zotero setup: enable {name} in Zotero's plugin manager and set its automatic updates to Off")
        else:
            print(f"zotero setup: enable {name} in Zotero's plugin manager if disabled")
    except (OSError, ValueError, KeyError, TypeError, BadZipFile) as error:
        warn(f"{name} installation skipped ({error})")


def install_better_bibtex(profile):
    if not bbt_plugin.is_file():
        warn("Better BibTeX package missing; run dotfiles-fetch sync and chezmoi apply")
        mark_deferred()
        return
    install_plugin(
        profile,
        "better-bibtex@iris-advies.com",
        "Better BibTeX",
        bbt_plugin,
        expected_version=bbt_tag.removeprefix("v"),
        check_updates=True,
    )


def install_extra_meta(profile):
    if not extra_meta_source.is_dir():
        warn("Extra Meta plugin source missing; skipping")
        return
    try:
        xpi_bytes = build_xpi(extra_meta_source)
    except (OSError, ValueError) as error:
        warn(f"Extra Meta installation skipped ({error})")
        return
    install_plugin(
        profile,
        "extra-meta@dotfiles.local",
        "Extra Meta",
        xpi_bytes,
        check_updates=False,
    )


profiles = ConfigParser(interpolation=None)
try:
    with (zotero / "profiles.ini").open(encoding="utf-8") as source:
        profiles.read_file(source)
    sections = [section for section in profiles.sections() if section.startswith("Profile")]
    defaults = [section for section in sections if profiles.getboolean(section, "Default", fallback=False)]
    if len(defaults) == 1:
        section = defaults[0]
    elif not defaults and len(sections) == 1:
        section = sections[0]
    else:
        raise ValueError("cannot identify the default profile")
    profile = Path(profiles.get(section, "Path"))
    if profiles.getboolean(section, "IsRelative", fallback=True):
        profile = zotero / profile
    if not profile.is_dir():
        raise ValueError("default profile directory does not exist")
except (OSError, Error, ValueError) as error:
    warn(f"profile unavailable ({error}); open Zotero and retry with chezmoi apply")
    raise SystemExit(0)

preferences(profile)
install_better_bibtex(profile)
install_extra_meta(profile)

if deferred:
    pending_marker.parent.mkdir(parents=True, exist_ok=True)
    pending_marker.write_text(f"{time.time_ns()}\n")
else:
    pending_marker.unlink(missing_ok=True)
PY
{{ end -}}
