{{- if has "agent-tools" (index .machines .machine).bundles -}}
{{- $adhd := index .agents.plugins "i-have-adhd" -}}
#!/usr/bin/env bash
# Install the pinned i-have-adhd skill for whichever agents this machine has.
#
# Re-runs when agent-plugins.sh, pinned rev, or Claude/Codex availability changes.
# agent-plugins.sh sha256: {{ include "dot_local/libexec/dotfiles/executable_agent-plugins.sh" | sha256sum }}
# i-have-adhd rev: {{ $adhd.rev }}
# claude at apply time: {{ if or (lookPath "claude") (stat (joinPath .chezmoi.homeDir ".local/bin/claude")) }}present{{ else }}absent{{ end }}
# codex at apply time: {{ if or (lookPath "codex") (stat (joinPath .chezmoi.homeDir ".local/share/pnpm/bin/codex")) }}present{{ else }}absent{{ end }}

set -eu

export PATH="$HOME/.local/share/pnpm/bin:$HOME/.local/bin:$PATH"
export I_HAVE_ADHD_REPO={{ $adhd.repo | quote }}
export I_HAVE_ADHD_PLUGIN={{ $adhd.plugin | quote }}
export I_HAVE_ADHD_REV={{ $adhd.rev | quote }}
exec "$HOME/.local/libexec/dotfiles/agent-plugins.sh"
{{ end -}}
