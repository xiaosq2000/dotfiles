#!/usr/bin/env bash
# Point every installed AI agent at the shared skills in ~/.agents/skills.
#
# Separate from the tool chain script because it is not gated on the machine's
# bundles: agent_skills.sh checks for each agent itself and does nothing when
# none is installed, so it is cheap and safe everywhere.
#
# Re-runs when the script or any skill changes.
# agent_skills.sh sha256: {{ include "dot_local/libexec/dotfiles/executable_agent-skills.sh" | sha256sum }}
# skills sha256: {{ range (glob (joinPath .chezmoi.sourceDir "dot_agents/skills/*/SKILL.md")) }}{{ include . | sha256sum }}{{ end }}
#
# The machines skill only deploys where the age key is (see .chezmoiignore), so
# a machine that gets the key later gains a skill without any SKILL.md changing.
# This line changes with it, so the links follow on that apply rather than
# waiting for some unrelated skill edit.
# age identity: {{ if stat (joinPath .chezmoi.homeDir .secrets.ageIdentity) }}present{{ else }}absent{{ end }}

set -eu

exec "$HOME/.local/libexec/dotfiles/agent-skills.sh"
