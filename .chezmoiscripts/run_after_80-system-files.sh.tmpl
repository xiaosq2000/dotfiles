{{- /*
Install this machine's root-owned files and missing distro system_packages:
everything under system/<bundle>/ (for this machine's bundles) and
system/<machine>/ goes to the same path under /, with system/<machine>/ winning
if both define the same target. chezmoi writes only into ~, so this script
copies them and installs missing system_packages with sudo. It never asks for a
password: without cached sudo credentials it lists what differs and exits 0.

Rootless hosts (`sudo = false`, such as `sicc`) and shared servers whose OS
layer is managed outside this repo (`manageSystem = false`, such as `imrl`)
render to nothing so apply stays strictly within `~`.

The template compares each file with its installed copy and probes each
declared system package via `stat`, rendering to nothing when everything
matches; chezmoi does not run an empty script. So `chezmoi diff` stays quiet,
and anything that could not be installed is retried on the next apply.

A file installs as root, mode 0755 if it is executable in git and 0644
otherwise. The comparison runs as the user, so every installed file must be
world-readable. Deleting a file from system/ leaves the installed copy.

This runs before 90-downloads, which has to run last.
*/ -}}
{{- $machineSpec := index .machines .machine -}}
{{- if and $machineSpec.sudo (get $machineSpec "manageSystem" | default false) -}}
{{-   $bundles := $machineSpec.bundles -}}
{{-   $selection := includeTemplate "software-selection" . | fromJson -}}
{{-   $roots := list -}}
{{-   range $b := $bundles -}}
{{-     if ne $b $.machine -}}
{{-       $roots = append $roots (joinPath $.chezmoi.sourceDir "system" $b) -}}
{{-     end -}}
{{-   end -}}
{{-   $roots = append $roots (joinPath .chezmoi.sourceDir "system" .machine) -}}
{{-   $byDst := dict -}}
{{-   range $root := $roots -}}
{{-     if stat $root -}}
{{-       range $src := glob (joinPath $root "**") -}}
{{-         $info := stat $src -}}
{{-         if not $info.isDir -}}
{{-           $dst := trimPrefix $root $src -}}
{{-           if and (not (contains "/__pycache__/" $dst)) (not (hasSuffix ".pyc" $dst)) (not (hasSuffix ".pyo" $dst)) -}}
{{-             $perm := 420 -}}
{{-             if eq (mod (div $info.perm 64) 2) 1 -}}
{{-               $perm = 493 -}}
{{-             end -}}
{{-             $_ := set $byDst $dst (dict "src" $src "dst" $dst "perm" $perm) -}}
{{-           end -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $files := list -}}
{{-   $units := list -}}
{{-   $systemd := false -}}
{{-   $udev := false -}}
{{-   $modprobe := false -}}
{{-   $keyd := false -}}
{{-   $logid := false -}}
{{-   range $dst := (keys $byDst | sortAlpha) -}}
{{-     $entry := index $byDst $dst -}}
{{-     $cur := stat $dst -}}
{{-     if or (not $cur) (ne $cur.perm $entry.perm) (ne (include $dst) (include $entry.src)) -}}
{{-       $files = append $files (dict "src" $entry.src "dst" $dst "mode" (printf "%o" $entry.perm)) -}}
{{-       if hasPrefix "/etc/systemd/" $dst -}}
{{-         $systemd = true -}}
{{-       end -}}
{{-       if regexMatch "^/etc/systemd/system/[^/]+\\.(service|socket|timer|path)$" $dst -}}
{{-         $units = append $units (base $dst) -}}
{{-       end -}}
{{-       if hasPrefix "/etc/udev/rules.d/" $dst -}}
{{-         $udev = true -}}
{{-       end -}}
{{-       if hasPrefix "/etc/modprobe.d/" $dst -}}
{{-         $modprobe = true -}}
{{-       end -}}
{{-       if hasPrefix "/etc/keyd/" $dst -}}
{{-         $keyd = true -}}
{{-       end -}}
{{-       if or (eq $dst "/etc/logid.cfg") (hasPrefix "/etc/systemd/system/logid.service.d/" $dst) -}}
{{-         $logid = true -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $missingPkgs := list -}}
{{-   range $pkgId := $selection.system_packages -}}
{{-     $spec := index $.system_packages $pkgId -}}
{{-     $present := false -}}
{{-     range $probePath := $spec.probe -}}
{{-       if stat $probePath -}}
{{-         $present = true -}}
{{-       end -}}
{{-     end -}}
{{-     if not $present -}}
{{-       $missingPkgs = append $missingPkgs (dict "id" $pkgId "spec" $spec) -}}
{{-     end -}}
{{-   end -}}
{{-   if or $files $missingPkgs -}}
#!/bin/sh
# Install files under system/<bundle>/ and system/{{ .machine }}/ that differ
# from their installed copies, and install missing declared system_packages.
# Rendered from .chezmoiscripts/run_after_80-system-files.sh.tmpl.
set -eu

if ! sudo -n true 2>/dev/null; then
{{-     if $files }}
    echo "system-files: these differ from {{ joinPath .chezmoi.sourceDir "system" }}:" >&2
{{-       range $files }}
    echo "system-files:   {{ .dst }}" >&2
{{-       end }}
{{-     end }}
{{-     if $missingPkgs }}
    echo "system-files: missing system_packages:" >&2
{{-       range $missingPkgs }}
    echo "system-files:   {{ .id }} ({{ .spec.description }})" >&2
{{-       end }}
{{-     end }}
    echo "system-files: run 'sudo -v && chezmoi apply' to install them" >&2
    exit 0
fi
{{     range $files }}
sudo -n install -D -o root -g root -m {{ .mode }} {{ .src | squote }} {{ .dst | squote }}
echo "system-files: installed {{ .dst }}"
{{-     end }}
{{-     if $systemd }}

sudo -n systemctl daemon-reload
{{-     end }}
{{-     range $units }}
sudo -n systemctl enable {{ . | squote }}
{{-     end }}
{{-     if $udev }}
sudo -n udevadm control --reload
{{-     end }}
{{-     if $modprobe }}
echo "system-files: module options take effect when the module next loads"
{{-     end }}
{{-     if $missingPkgs }}

pkg_mgr=""
if command -v apt-get >/dev/null 2>&1; then
    pkg_mgr="apt"
    if ! sudo -n env DEBIAN_FRONTEND=noninteractive apt-get update; then
        echo "system-files: warning: apt-get update failed; trying package installs anyway" >&2
    fi
elif command -v dnf >/dev/null 2>&1; then
    pkg_mgr="dnf"
elif command -v pacman >/dev/null 2>&1; then
    pkg_mgr="pacman"
elif command -v zypper >/dev/null 2>&1; then
    pkg_mgr="zypper"
else
    echo "system-files: warning: unsupported package manager; install missing system_packages manually" >&2
fi

install_pkg_entry() {
    entry_id="$1"
    unit_name="$2"
    shift 2
    if [ "$#" -eq 0 ] || [ -z "$pkg_mgr" ]; then
        echo "system-files: warning: no $pkg_mgr mapping for system package '$entry_id'" >&2
        return 0
    fi
    installed_ok=0
    case "$pkg_mgr" in
        apt)
            # Keep files just deployed from system/ (such as /etc/logid.cfg)
            # instead of letting dpkg prompt on package-provided conffiles.
            if sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y \
                -o Dpkg::Options::=--force-confdef \
                -o Dpkg::Options::=--force-confold \
                "$@" </dev/null; then
                installed_ok=1
            fi
            ;;
        dnf)
            if sudo -n dnf install -y "$@"; then
                installed_ok=1
            fi
            ;;
        pacman)
            if sudo -n pacman -S --noconfirm --needed "$@"; then
                installed_ok=1
            fi
            ;;
        zypper)
            if sudo -n zypper --non-interactive install "$@"; then
                installed_ok=1
            fi
            ;;
    esac
    if [ "$installed_ok" -eq 1 ]; then
        echo "system-files: installed system package '$entry_id'"
        if [ -n "$unit_name" ]; then
            sudo -n systemctl enable --now "$unit_name" || true
            if [ "$unit_name" = "keyd.service" ]; then
                KEYD_BIN="$(command -v keyd.rvaiya 2>/dev/null || command -v keyd 2>/dev/null || true)"
                if [ -n "$KEYD_BIN" ] && systemctl is-active --quiet keyd.service; then
                    sudo -n "$KEYD_BIN" reload || true
                fi
            fi
        fi
    else
        echo "system-files: warning: failed to install system package '$entry_id'; retry later with 'sudo -v && chezmoi apply'" >&2
    fi
}

if [ -n "$pkg_mgr" ]; then
{{-       range $missingPkgs }}
{{-         $unit := get .spec "enable_unit" | default "" }}
    case "$pkg_mgr" in
        apt)    install_pkg_entry {{ .id | squote }} {{ $unit | squote }}{{ range (get .spec "apt" | default list) }} {{ . | squote }}{{ end }} ;;
        dnf)    install_pkg_entry {{ .id | squote }} {{ $unit | squote }}{{ range (get .spec "dnf" | default list) }} {{ . | squote }}{{ end }} ;;
        pacman) install_pkg_entry {{ .id | squote }} {{ $unit | squote }}{{ range (get .spec "pacman" | default list) }} {{ . | squote }}{{ end }} ;;
        zypper) install_pkg_entry {{ .id | squote }} {{ $unit | squote }}{{ range (get .spec "zypper" | default list) }} {{ . | squote }}{{ end }} ;;
    esac
{{-       end }}
fi
{{-     end }}
{{-     if $keyd }}

KEYD_BIN="$(command -v keyd.rvaiya 2>/dev/null || command -v keyd 2>/dev/null || true)"
if [ -n "$KEYD_BIN" ]; then
    if systemctl is-active --quiet keyd.service; then
        sudo -n "$KEYD_BIN" reload
        echo "system-files: reloaded keyd"
    else
        echo "system-files: keyd is installed but inactive; run 'dotfiles host keymap on' to activate"
    fi
fi
{{-     end }}
{{-     if $logid }}

if systemctl is-active --quiet logid.service 2>/dev/null; then
    sudo -n systemctl restart logid.service
    echo "system-files: restarted logid"
fi
{{-     end }}
{{-   end -}}
{{- end -}}
