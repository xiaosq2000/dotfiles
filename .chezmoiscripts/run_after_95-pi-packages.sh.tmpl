{{- $needs_install := false -}}
{{- if has "dev" (index .machines .machine).bundles -}}
{{-   range $name := .agents.pi.packages -}}
{{-     $manifest := joinPath $.chezmoi.homeDir ".pi/agent/npm/node_modules" $name "package.json" -}}
{{-     if stat $manifest -}}
{{-       $parsed := include $manifest | fromJson -}}
{{-       if ne (get $parsed "name" | default "") $name -}}
{{-         $needs_install = true -}}
{{-       end -}}
{{-     else -}}
{{-       $needs_install = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if $needs_install -}}
#!/usr/bin/env bash
# Run after mise installs Pi. Renders empty once every declared package is
# present (or dev is unselected), so `chezmoi status` and `chezmoi verify` stay
# clean while missing installs retry. Upgrade anytime via `pi update --extensions`
# or `dotfiles upgrade --only pi`.
set -eu
export PATH="$HOME/.local/share/mise/shims:$PATH"
if ! command -v python3 >/dev/null 2>&1; then
    echo "pi packages: python3 not found; run chezmoi apply after installation" >&2
    exit 0
fi

exec python3 - <<'PY'
import json
import os
from pathlib import Path
import shutil
import subprocess

WANTED = json.loads({{ .agents.pi.packages | toJson | quote }})
home = Path.home()
agent = home / ".pi/agent"
pi_shim = home / ".local/share/mise/shims/pi"
pi = pi_shim if os.access(pi_shim, os.X_OK) else None


def warn(message):
    print(f"pi packages: {message}; retry with chezmoi apply", flush=True)


try:
    settings = json.loads((agent / "settings.json").read_text())
    configured = settings["packages"]
    if not isinstance(configured, list):
        raise ValueError("packages must be an array")
except (OSError, ValueError, KeyError, TypeError):
    warn("settings unavailable or invalid, installation skipped")
    raise SystemExit(0)

pending = []
for name in WANTED:
    source = f"npm:{name}"
    if source not in configured:
        warn(f"shared declaration absent for {name}, installation skipped")
        continue
    manifest = agent / "npm/node_modules" / name / "package.json"
    try:
        installed = json.loads(manifest.read_text())
        if installed.get("name") == name:
            continue
    except (OSError, ValueError, AttributeError):
        pass
    pending.append(source)

if not pending:
    raise SystemExit(0)
if pi is None or not all(shutil.which(tool) for tool in ("node", "npm")):
    warn("managed Pi or Node/npm missing, installation skipped")
    raise SystemExit(0)

environment = os.environ.copy()
environment["PI_CODING_AGENT_DIR"] = str(agent)
environment["PI_TELEMETRY"] = "0"
# A project package must not affect a personal installation.
for source in pending:
    print(f"pi packages: installing {source}", flush=True)
    try:
        subprocess.run([str(pi), "install", source], cwd=home, env=environment,
                       check=True, timeout=180)
    except (OSError, subprocess.SubprocessError):
        warn(f"installation failed for {source}")
PY
{{ end -}}
