{{- $selection := includeTemplate "software-selection" . | fromJson -}}
{{- if $selection.mise -}}
#!/usr/bin/env bash
# Sync cross-platform CLIs managed by mise from ~/.config/mise/config.toml.
# Existing installed tools stay at their installed version until upgraded
# explicitly via `dotfiles upgrade` (or `mise upgrade`).
#
# Runs after 05-pixi (which installs mise) and before 06b-mise-retry, 07-sheldon,
# 08-source-repo (pre-commit + gitleaks), 10-pnpm (pnpm + node), and
# 95-pi-packages (pi + node).
#
# Retries after a failure live in run_after_06b-mise-retry.sh.tmpl instead of a
# pending marker comment here, so clearing mise-pending on success never
# self-invalidates this script's onchange hash.
#
# config sha256: {{ includeTemplate "private_dot_config/mise/config.toml.tmpl" . | sha256sum }}
# mise at apply time: {{ if or (lookPath "mise") (stat (joinPath .chezmoi.homeDir ".pixi/bin/mise")) }}present{{ else }}absent{{ end }}

{{ includeTemplate "mise-sync.sh" . }}
{{- end -}}
