// Installed by chezmoi from system/desktop/ in the dotfiles repository.
//
// Allow an active local desktop session in the sudo group to start, stop, or
// restart keyd.service without a password prompt, so `dotfiles keymap` can
// switch between HHKB and standard layouts cleanly without adding the user to
// the input group. Lives in /usr/share/polkit-1/rules.d/ rather than
// /etc/polkit-1/rules.d/ because the latter is mode 0750 root:polkitd on
// Ubuntu and unreadable by unprivileged `chezmoi apply` comparisons.
//
// Checked on 2026-11-22 with polkit 127 on Ubuntu.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "keyd.service" &&
        (action.lookup("verb") === "start" ||
         action.lookup("verb") === "stop" ||
         action.lookup("verb") === "restart") &&
        subject.local &&
        subject.active &&
        subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
