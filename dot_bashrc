# shellcheck shell=bash
# ~/.bashrc: minimal interactive bash fallback. Primary interactive shell is zsh.
# Non-interactive SSH bash shells also read ~/.bashrc on Debian/Ubuntu, so load
# the silent shared POSIX environment before checking interactivity.

if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/env.sh" ]; then
    # shellcheck source=/dev/null
    . "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/env.sh"
fi

case $- in
    *i*) ;;
    *) return ;;
esac

_has() { command -v "$1" >/dev/null 2>&1; }

# History and terminal behaviour
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
HISTTIMEFORMAT="%F %T "
shopt -s histappend checkwinsize

# Editors
if _has nvim; then
    export EDITOR=nvim SUDO_EDITOR=nvim
elif _has vim; then
    export EDITOR=vim SUDO_EDITOR=vim
elif _has vi; then
    export EDITOR=vi SUDO_EDITOR=vi
fi
[ -n "${EDITOR:-}" ] && export GIT_EDITOR="$EDITOR"

# Colors and core aliases
if _has dircolors; then
    if [ -r "$HOME/.dircolors" ]; then
        eval "$(dircolors -b "$HOME/.dircolors")"
    else
        eval "$(dircolors -b)"
    fi
    alias grep='grep --color=auto'
fi

if _has eza; then
    alias ls='eza --group-directories-first --icons=auto'
    alias la='eza -a --group-directories-first --icons=auto'
    alias ll='eza -la --group-directories-first --icons=auto --git'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
fi

alias lg='lazygit'
alias t='tmux'
alias ta='tmux a'
alias python='python3'

if [ -r "$HOME/.bash_aliases" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.bash_aliases"
fi

# Programmable completion
if ! shopt -oq posix; then
    if [ -r /usr/share/bash-completion/bash_completion ]; then
        # shellcheck source=/dev/null
        . /usr/share/bash-completion/bash_completion
    elif [ -r /etc/bash_completion ]; then
        # shellcheck source=/dev/null
        . /etc/bash_completion
    fi
fi

# Interactive tool integrations
if _has fzf; then
    eval "$(fzf --bash)"
    if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/current-theme.zsh" ]; then
        # shellcheck source=/dev/null
        . "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/current-theme.zsh"
    fi
fi

if _has zoxide; then
    eval "$(zoxide init bash)"
fi

if [ "${TERM:-}" != "dumb" ] && _has starship; then
    eval "$(starship init bash)"
else
    PS1='\u@\h:\w\$ '
fi

# Default-jail primary coding agents in interactive bash too (`unjail <agent>` to bypass).
unjail() {
    DOTFILES_NO_JAIL=1 "$@"
}

if _has agent-jail; then
    _dotfiles_run_jailed() {
        local _agent="$1"
        shift
        case "$_agent:${1:-}" in
            *:-h|*:-v|*:-V|*:--help|*:--version|*:help|*:update|*:install|*:mcp|*:plugin|*:plugins|*:doctor)
                command "$_agent" "$@"
                return
                ;;
            codex:completion|codex:login|codex:logout|codex:sandbox|codex:debug|codex:features|codex:agents|codex:apply|codex:archive|codex:delete|codex:unarchive|codex:queue|codex:migrate-*)
                command "$_agent" "$@"
                return
                ;;
            claude:auth|claude:config|claude:setup-token)
                command "$_agent" "$@"
                return
                ;;
            agy:acp|agy:agent|agy:agents|agy:changelog|agy:mic-serve|agy:models|agy:remote-control)
                command "$_agent" "$@"
                return
                ;;
            pi:remove|pi:list|pi:config)
                command "$_agent" "$@"
                return
                ;;
        esac
        command agent-jail --wrap "$_agent" -- "$@"
    }
    if _has claude; then claude() { _dotfiles_run_jailed claude "$@"; }; fi
    if _has codex; then codex() { _dotfiles_run_jailed codex "$@"; }; fi
    if _has agy; then agy() { _dotfiles_run_jailed agy "$@"; }; fi
    if _has pi; then pi() { _dotfiles_run_jailed pi "$@"; }; fi
fi

# Proxy client
_sbc="${XDG_DATA_HOME:-$HOME/.local/share}/sbc/cli/sbc"
if [ -x "$_sbc" ]; then
    eval "$("$_sbc" init bash)"
fi
unset _sbc
unset -f _has
