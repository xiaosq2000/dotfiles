# Patterns here match paths in the destination directory (~), not the source.
#
# This file replaces the ~100 line inverted .gitignore the old layout needed.
# That file had to start with `/*` and then re-admit every tracked path with a
# matching `!path` / `path/*` pair, because the repository's working tree was
# $HOME itself and so every unrelated file in $HOME was a candidate. chezmoi
# keeps its source tree separate, so the default is already "manage nothing",
# and only genuine exceptions belong here.

# Repository documentation, not dotfiles. They sit at the source root so they
# render on GitHub; without these lines chezmoi would deploy them to ~/README.md
# and ~/docs.
README.md
docs

# Instructions for agents working on this repository, at the root where agents
# look for them. Deployed, they would land in ~, and ~/CLAUDE.md in particular
# would load into every Claude Code session started in the home directory.
AGENTS.md
CLAUDE.md

# Keep local archives out of the destination. Actual checkouts must live outside
# this tree: ignoring them does not stop chezmoi loading their template data.
.worktrees

# The age identity: the one file that must never be committed, since it decrypts
# every encrypted_ file in this repository. chezmoi would not add it on its own,
# but ~/.config/chezmoi is a directory this repository does write to, so say so
# explicitly.
.config/chezmoi/key.txt

# ssh private keys, for the same reason. chezmoi does not manage them, and a
# stray `chezmoi add ~/.ssh` must not start. With this entry chezmoi refuses the
# keys even with --encrypt, and still takes ~/.ssh/config. The public halves
# are harmless, so they stay addable.
.ssh/id_*
!.ssh/id_*.pub

# .secrets is a separate, local-only repository that happens to live in $HOME.
# It must never be managed here and must never reach this public repo. chezmoi
# would not pick it up on its own, but a stray `chezmoi add ~/.secrets` would,
# and that mistake is unrecoverable once pushed.
.secrets

# lazy.nvim's lockfile. It cannot be one shared file: lazy rewrites it whenever
# a machine updates its plugins, and the plugin set is theme-dependent, so a
# machine on a Rosé Pine variant has no catppuccin entry at all. Managing it
# meant `chezmoi apply` downgraded a machine's plugins and `re-add` pushed one
# machine's theme-specific lock onto the rest.
#
# It also broke non-interactive applies outright. chezmoi prompts before
# overwriting a target that drifted, and over ssh there is no TTY, so
# `chezmoi update` on imrl aborted with "could not open a new TTY" and left
# every target sorting after it untouched.
#
# lazy regenerates it per machine, which is where the pinning belongs.
.config/nvim/lazy-lock.json

# Everything under .pixi except the global manifest: the environments are
# gigabytes of solved packages that `pixi global sync` rebuilds from
# .pixi/manifests/pixi-global.toml.
.pixi/envs
.pixi/bin

{{ if not (stat (joinPath .chezmoi.homeDir .secrets.ageIdentity)) -}}
# No age identity on this machine, so do not manage the encrypted files.
#
# Without this, chezmoi tries to decrypt them, fails, and stops the apply where
# it stood. That is worse than it sounds, because it aborts rather than skips:
# every target sorting after the failed one is left untouched, and .ssh/config
# sorts before .zshrc. A machine whose vault happens to be locked would quietly
# stop updating its shell config, with the error naming only ~/.ssh/config.
#
# Ignoring them instead means the machine applies everything it can have and
# simply does not have these. The identity arrives via
# run_onchange_before_00-age-identity.sh, or by hand; see docs/secrets.md.
#
# Add an entry here for every new encrypted_ file. CI checks the result rather
# than the list: a keyless machine has to apply cleanly, which fails the moment
# an encrypted target is not covered.
.ssh/config

# The machines skill goes whole rather than just its encrypted pages. Its
# SKILL.md is plaintext and could deploy, but it tells an agent to read pages
# that would not be there.
.agents/skills/machines
{{ end -}}

{{ if not (has "desktop" (index .machines .machine).bundles) -}}
# GUI settings are retained when deselected, like application profiles.
.config/kitty
.config/alacritty
.config/zathura
.config/fcitx5
.config/kmonad
.config/environment.d/im.conf
.config/autostart/org.fcitx.Fcitx5.desktop
.local/bin/zathura
{{ end -}}
{{- $selection := includeTemplate "software-selection" . | fromJson -}}
{{- range $id, $spec := .downloads -}}
{{- if and (not (has $id $selection.externals)) (not (stat (joinPath $.chezmoi.homeDir ".local/state/dotfiles/downloads" (printf "%s.json" $id)))) }}
# An unselected, never-adopted resource must not replace a manual installation.
{{ range (includeTemplate "download-targets" $spec | fromJson) }}{{ . }}
{{ end -}}
{{ end -}}
{{ end -}}
