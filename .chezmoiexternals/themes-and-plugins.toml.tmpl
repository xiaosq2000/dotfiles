{{- $t := index .themes .theme -}}
{{- $s := index .schemes $t.scheme -}}
# Fixed target names let a theme switch replace the active theme in place.
# Starship is rendered directly because it has no include mechanism.

{{ if has "desktop" (index .machines .machine).bundles }}
[".config/kitty/current-theme.conf"]
type = "file"
url = {{ printf $s.kittyURL $t.kitty | quote }}
refreshPeriod = "672h"

{{ end }}
[".config/btop/themes/current.theme"]
type = "file"
url = {{ printf $s.btopURL $t.btop | quote }}
refreshPeriod = "672h"

{{ if has "desktop" (index .machines .machine).bundles }}
[".config/alacritty/current-theme.toml"]
type = "file"
url = {{ printf $s.alacrittyURL $t.alacritty | quote }}
refreshPeriod = "672h"

{{ end }}
# tmux's configured plugins require this checkout. chezmoi refreshes it without
# deleting tpm's record of installed plugins.
[".local/share/tmux/plugins/tpm"]
type = "git-repo"
url = "https://github.com/tmux-plugins/tpm"
refreshPeriod = "672h"
