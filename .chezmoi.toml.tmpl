{{/*
Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.

Only the three answers below are per-machine. Everything derived from the
theme lives in .chezmoidata/themes.toml and is looked up at apply time, so
changing a colour there takes effect on the next `chezmoi apply` without
re-running init.

The prompt strings double as the keys for chezmoi's non-interactive flags, so
they are kept short and free of commas, which the flag parser splits on:

  chezmoi init --apply \
    --promptChoice theme=main \
    --promptBool installBinaries=true \
    --promptBool installTypefaces=false \
    git@github.com:xiaosq2000/dotfiles.git

  theme            main | moon | dawn -- see .chezmoidata/themes.toml
  installBinaries  run the ~/.sh_utils/setup.d tool chain (pixi, uv, rust,
                   node, zsh, neovim, fzf, yazi, lazydocker)
  installTypefaces install Maple Mono and friends
*/}}
{{- $theme := promptChoiceOnce . "theme" "theme" (list "main" "moon" "dawn") "main" -}}
{{- $binaries := promptBoolOnce . "installBinaries" "installBinaries" true -}}
{{- $typefaces := promptBoolOnce . "installTypefaces" "installTypefaces" false -}}

# Write directories 0755 and files 0644 instead of following the login shell's
# umask, which is 002 here.
#
# This matters for ~/.local/bin. chezmoi derives directory modes from the
# umask, so by default it wants that directory to be 0775, while the uv and
# yazi installers that also write binaries into it reset it to 0755 on every
# run. The two then alternate forever and `chezmoi diff` is never empty.
# Pinning the umask settles it in the installers' favour.
#
# The one-time cost is that roughly 190 entries created under umask 002 get
# their group-write bit cleared on the first apply. That is a tightening, so
# nothing breaks. Paths needing to be tighter still carry a private_ prefix:
# ~/.config itself, and the fcitx5 profile and conf files, which hold input
# history.
umask = 0o022

[data]
    # Selects a column from .chezmoidata/themes.toml. Switch with `theme dawn`,
    # which rewrites this line and runs `chezmoi apply`.
    theme = {{ $theme | quote }}
    # Gates run_onchange_after_10-setup-tools.sh. Set false on a machine where
    # you only want the config files and not the tool chain.
    installBinaries = {{ $binaries }}
    installTypefaces = {{ $typefaces }}
