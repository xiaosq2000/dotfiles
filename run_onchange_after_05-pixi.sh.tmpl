#!/usr/bin/env bash
# Syncs the pixi global tool set from the rendered manifest.
#
# Split out of 10-setup-tools so that a manifest change actually redeploys.
# That script's hashes cover only the installer scripts in setup.d, so adding
# a tool changed nothing chezmoi could see: the entry reached the manifest file
# on every machine, but the rendered run script was byte-identical,
# run_onchange_ did not fire, and `pixi global sync` never ran. The tool was
# declared everywhere and installed nowhere.
#
# The hash below is of the manifest as rendered for this machine, via
# includeTemplate rather than include. `include` would return the template's own
# source text, which does not change when .chezmoidata/tools.toml or
# .chezmoidata/machines.toml changes, so editing a bundle would not re-sync and
# the gap this script exists to close would reopen in a new form.
#
# Runs before 10-setup-tools because what remains there expects the tools pixi
# provides to already be on PATH.
#
# pixi.sh sha256:   {{ include "dot_sh_utils/setup.d/executable_pixi.sh" | sha256sum }}
# manifest sha256:  {{ includeTemplate "dot_pixi/manifests/pixi-global.toml.tmpl" . | sha256sum }}

set -eu

{{ if not (index .machines .machine).bundles -}}
echo "machine {{ .machine }} selects no bundles; skipping pixi global sync"
exit 0
{{ end -}}

exec "$HOME/.sh_utils/setup.d/pixi.sh"
