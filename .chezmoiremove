# Cleanup of things this repository used to install and no longer does.
#
# Deleting a source entry makes chezmoi stop managing the target, but it does
# not delete the copy already in ~. This does. Likewise, dropping a setup.d
# installer stops it running but leaves whatever it already installed behind.
#
# This file is a template, and the binary entries below are guarded on the
# replacement already being present in ~/.pixi/bin. Removals happen before the
# run_ scripts during an apply, so an unguarded entry would delete the editor
# from a machine and only then try to download its replacement; if that download
# failed, on a login node behind a proxy for instance, the machine would be left
# with no editor at all. Guarded, the first apply installs the pixi copy and the
# second removes the old one.
#
# Entries here take effect on every apply, so each block says when it can go.

################################################################################
# 2026-09: the yazi plugin that was dropped
#
# Safe to delete this block once it has been applied on laptop and vps, the two
# machines that were not reachable when it was written.
################################################################################

# The dedukun/bookmarks.yazi plugin and the two yazi config files that existed
# only to configure it.
.config/yazi/plugins/bookmarks.yazi
.config/yazi/plugins
.config/yazi/init.lua
.config/yazi/keymap.toml

# yazi now comes from the pixi manifest, so these are the binaries the old
# setup.d/yazi.sh unpacked from a GitHub release (~33 MB). pixi's copies live
# in ~/.pixi/bin and are unaffected.
.local/bin/yazi
.local/bin/ya

# The retired installer itself.
.sh_utils/setup.d/yazi.sh

################################################################################
# 2026-09-18: the installers replaced by conda-forge packages
#
# Each of these was a script that resolved a GitHub release, guessed an asset
# name and unpacked it into ~/.local. All five packages are on conda-forge and
# are bundle entries in .chezmoidata/tools.toml now.
#
# Safe to delete this block once every machine has applied it twice.
################################################################################

# neovim.sh did `cp -a` of the whole release tarball into ~/.local, so it left a
# binary, a lib directory and a copy of the runtime. ~/.local/share/nvim is
# deliberately NOT listed: the tarball's runtime/ landed in there beside lazy/,
# mason/, site/ and the session files, which are plugin state and are not
# replaceable. The stale runtime/ is inert, because nvim resolves its runtime
# relative to its own binary. See docs/todo.md.
{{ if stat (joinPath .chezmoi.homeDir ".pixi/bin/nvim") }}.local/bin/nvim
.local/lib/nvim
{{ end }}
# uv.sh. The tool shims in ~/.local/bin that uv itself created, for nvitop and
# the rest, point into ~/.local/share/uv/tools and keep working without this
# binary.
{{ if stat (joinPath .chezmoi.homeDir ".pixi/bin/uv") }}.local/bin/uv
.local/bin/uvx
{{ end }}
# lazydocker.sh
{{ if stat (joinPath .chezmoi.homeDir ".pixi/bin/lazydocker") }}.local/bin/lazydocker
{{ end }}
# luarocks.sh
{{ if stat (joinPath .chezmoi.homeDir ".pixi/bin/luarocks") }}.local/bin/luarocks
.local/bin/luarocks-admin
{{ end }}
# fzf.sh cloned the upstream repository into ~/.fzf and ran its installer with
# --xdg, which wrote the two shell integration files. .zshrc uses `fzf --zsh`
# now, so nothing reads either path.
{{ if stat (joinPath .chezmoi.homeDir ".pixi/bin/fzf") }}.fzf
.config/fzf/fzf.zsh
.config/fzf/fzf.bash
.config/fzf
{{ end }}
# The retired installers themselves. Unguarded: they are inert scripts, and
# leaving them invites running one by hand and undoing the migration.
.sh_utils/setup.d/uv.sh
.sh_utils/setup.d/neovim.sh
.sh_utils/setup.d/fzf.sh
.sh_utils/setup.d/lazydocker.sh
.sh_utils/setup.d/luarocks.sh
.sh_utils/setup.d/tpm.sh

################################################################################
# 2026-09-18: vendored theme files, now fetched to a fixed name
#
# btop.conf reads themes/current.theme and alacritty.toml imports
# current-theme.toml; both are fetched from the scheme's upstream repository by
# .chezmoiexternal.toml. The per-variant copies below were committed to this
# repository, one per variant per tool, which is what made supporting a second
# colour scheme a matter of hand-copying twelve more files.
#
# Guarded on the fetched file existing, so a machine that could not reach
# GitHub keeps the colours it already had.
################################################################################

{{ if stat (joinPath .chezmoi.homeDir ".config/btop/themes/current.theme") }}.config/btop/themes/rose-pine.theme
.config/btop/themes/rose-pine-moon.theme
.config/btop/themes/rose-pine-dawn.theme
.config/btop/themes/rose-pine-main.theme
{{ end }}
{{ if stat (joinPath .chezmoi.homeDir ".config/alacritty/current-theme.toml") }}.config/alacritty/rose-pine.toml
.config/alacritty/rose-pine-moon.toml
.config/alacritty/rose-pine-dawn.toml
{{ end }}

################################################################################
# 2026-09-18: oh-my-zsh
#
# Replaced by sheldon and ~/.config/sheldon/plugins.toml. 23 MB of framework for
# five plugins, of which .zshrc loaded eleven more that this shell history shows
# no use of at all.
#
# Guarded on sheldon having cloned its plugins, so a machine that could not
# reach GitHub keeps a working shell. ~/.zsh_history is deliberately absent from
# this list: it lives in $HOME, not under ~/.oh-my-zsh, and nothing here touches
# it.
#
# Safe to delete this block once every machine has applied it twice.
################################################################################

{{ if stat (joinPath .chezmoi.homeDir ".local/share/sheldon/plugins.lock") }}.oh-my-zsh
{{ end }}
