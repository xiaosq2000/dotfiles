{{- $selection := includeTemplate "software-selection" . | fromJson -}}
{{- range $id, $spec := .downloads -}}
{{- $marker := printf ".local/state/dotfiles/downloads/%s.json" $id -}}
{{- if and (not (has $id $selection.externals)) (stat (joinPath $.chezmoi.homeDir $marker)) }}
{{- /* Empty integration templates perform their own removal. */ -}}
{{ range (includeTemplate "download-targets" $spec | fromJson) -}}
{{ if not (has . (get $spec "integration" | default list)) }}{{ . }}
{{ end -}}
{{ end }}{{ $marker }}
{{ end -}}
{{- if and (has $id $selection.externals) (eq $spec.kind "font") (hasKey $spec "ownership") -}}
{{- /* A direct font download still owns a whole family directory. Remove old
      alternate builds after the before hook has backed up that directory. */ -}}
{{- $files := list -}}
{{- range $spec.entries }}{{ $files = append $files (joinPath $.chezmoi.homeDir .target) }}{{ end -}}
{{- range $directory := $spec.ownership -}}
{{- range $path := glob (joinPath $.chezmoi.homeDir $directory "*") -}}
{{- if not (has $path $files) }}
{{ trimPrefix (printf "%s/" $.chezmoi.homeDir) $path }}
{{ end -}}
{{ end -}}
{{ end -}}
{{ end -}}
{{ end }}
