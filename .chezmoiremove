{{- $m := index .machines .machine -}}
{{- /*
   The packages this machine actually wants, so that a removal can tell "the
   replacement has not arrived yet" from "this machine does not want the tool".
*/ -}}
{{- $selected := list -}}
{{- range $b := $m.bundles -}}
{{-   $selected = concat $selected (index $.bundles $b).packages -}}
{{- end -}}
{{- /*
   Binaries that used to be installed by a setup.d script or by cargo, and now
   come from a pixi bundle. Each is removed when either the pixi copy is already
   in place, or the package is not in this machine's bundles at all.

   Both halves matter. Removals run before the run_ scripts during an apply, so
   an unguarded entry would delete the editor from a machine and only then try
   to download its replacement; if that download failed, on a login node behind
   a proxy for instance, the machine would be left with no editor. But gating
   only on the pixi copy left a stale ~/.local/bin/lazydocker on sicc, because
   sicc does not take the bundle that provides lazydocker, so the replacement
   was never going to appear and the old binary would have stayed for good.
*/ -}}
{{- $replaced := list
      (dict "pkg" "nvim"            "bin" "nvim"        "paths" (list ".local/bin/nvim" ".local/lib/nvim"))
      (dict "pkg" "uv"              "bin" "uv"          "paths" (list ".local/bin/uv" ".local/bin/uvx"))
      (dict "pkg" "lazydocker"      "bin" "lazydocker"  "paths" (list ".local/bin/lazydocker"))
      (dict "pkg" "luarocks"        "bin" "luarocks"    "paths" (list ".local/bin/luarocks" ".local/bin/luarocks-admin"))
      (dict "pkg" "fzf"             "bin" "fzf"         "paths" (list ".fzf" ".config/fzf/fzf.zsh" ".config/fzf/fzf.bash" ".config/fzf"))
      (dict "pkg" "starship"        "bin" "starship"    "paths" (list ".local/bin/starship"))
      (dict "pkg" "difftastic"      "bin" "difft"       "paths" (list ".local/bin/difft"))
      (dict "pkg" "lazygit"         "bin" "lazygit"     "paths" (list ".local/bin/lazygit"))
      (dict "pkg" "tree-sitter-cli" "bin" "tree-sitter" "paths" (list ".local/bin/tree-sitter"))
      (dict "pkg" "huggingface_hub" "bin" "hf"          "paths" (list ".local/bin/hf" ".local/bin/huggingface-cli" ".local/bin/tiny-agents"))
-}}
# Cleanup of things this repository used to install and no longer does.
#
# Deleting a source entry makes chezmoi stop managing the target, but it does
# not delete the copy already in ~. This does. Likewise, dropping a setup.d
# installer stops it running but leaves whatever it already installed behind.
#
# This file is a template; the comment at the top of the source explains how the
# binary entries are guarded.
#
# Entries here take effect on every apply, so each block says when it can go.
#
# Rendered for machine: {{ .machine }}

################################################################################
# 2026-09: the yazi plugin that was dropped
#
# Safe to delete this block once it has been applied on laptop and vps, the two
# machines that were not reachable when it was written.
################################################################################

# The dedukun/bookmarks.yazi plugin and the two yazi config files that existed
# only to configure it.
.config/yazi/plugins/bookmarks.yazi
.config/yazi/plugins
.config/yazi/init.lua
.config/yazi/keymap.toml

# yazi now comes from the pixi manifest, so these are the binaries the old
# setup.d/yazi.sh unpacked from a GitHub release (~33 MB). pixi's copies live
# in ~/.pixi/bin and are unaffected.
.local/bin/yazi
.local/bin/ya

# The retired installer itself.
.sh_utils/setup.d/yazi.sh

################################################################################
# 2026-09-18: binaries that moved into a pixi bundle
#
# Each was a setup.d script resolving a GitHub release and unpacking it into
# ~/.local, or a `cargo install` that put a copy there. All of them are
# conda-forge packages now, and a leftover copy in ~/.local/bin is not harmless:
# depending on where ~/.pixi/bin lands in PATH it can win, and then the manifest
# says one thing and `command -v` another.
#
# ~/.local/share/nvim is deliberately absent. neovim.sh did `cp -a` of the whole
# release tarball into ~/.local, so the tarball's runtime/ landed in there
# beside lazy/, mason/, site/ and the session files, which are plugin state and
# are not replaceable. The stale runtime/ is inert, because nvim resolves its
# runtime relative to its own binary. See docs/todo.md.
#
# Safe to delete this block once every machine has applied it twice.
################################################################################
{{ range $e := $replaced }}
{{- if or (stat (joinPath $.chezmoi.homeDir ".pixi/bin" $e.bin)) (not (has $e.pkg $selected)) -}}
{{ range $p := $e.paths }}{{ $p }}
{{ end }}
{{- end }}
{{- end }}
# The retired installers themselves. Unguarded: they are inert scripts, and
# leaving them invites running one by hand and undoing the migration.
.sh_utils/setup.d/uv.sh
.sh_utils/setup.d/neovim.sh
.sh_utils/setup.d/fzf.sh
.sh_utils/setup.d/lazydocker.sh
.sh_utils/setup.d/luarocks.sh
.sh_utils/setup.d/tpm.sh
.sh_utils/setup.d/zsh.sh

################################################################################
# 2026-09-18: vendored theme files, now fetched to a fixed name
#
# btop.conf reads themes/current.theme and alacritty.toml imports
# current-theme.toml; both are fetched from the scheme's upstream repository by
# .chezmoiexternal.toml. The per-variant copies below were committed to this
# repository, one per variant per tool, which is what made supporting a second
# colour scheme a matter of hand-copying twelve more files.
#
# Guarded on the fetched file existing, so a machine that could not reach GitHub
# keeps the colours it already had.
################################################################################

{{ if stat (joinPath .chezmoi.homeDir ".config/btop/themes/current.theme") }}.config/btop/themes/rose-pine.theme
.config/btop/themes/rose-pine-moon.theme
.config/btop/themes/rose-pine-dawn.theme
.config/btop/themes/rose-pine-main.theme
{{ end }}
{{ if stat (joinPath .chezmoi.homeDir ".config/alacritty/current-theme.toml") }}.config/alacritty/rose-pine.toml
.config/alacritty/rose-pine-moon.toml
.config/alacritty/rose-pine-dawn.toml
{{ end }}
################################################################################
# 2026-09-18: oh-my-zsh
#
# Replaced by sheldon and ~/.config/sheldon/plugins.toml. 23 MB of framework for
# five plugins, of which .zshrc loaded eleven more that this shell history shows
# no use of at all.
#
# Guarded on sheldon having cloned its plugins, so a machine that could not
# reach GitHub keeps a working shell. ~/.zsh_history is deliberately absent from
# this list: it lives in $HOME, not under ~/.oh-my-zsh, and nothing here touches
# it.
#
# Safe to delete this block once every machine has applied it twice.
################################################################################

{{ if stat (joinPath .chezmoi.homeDir ".local/share/sheldon/plugins.lock") }}.oh-my-zsh
{{ end }}

################################################################################
# 2026-09-19: gnome-terminal, dropped entirely
#
# .chezmoiexternal.toml checked out a Rosé Pine gnome-terminal theme and nothing
# ever loaded its template.dconf into dconf. gnome-terminal is not used any
# more, so the checkout, the dead set_gnome_terminal_as_default function and the
# version probe in checkers.sh are all gone.
#
# Unconditional: this is a clean break on every machine. The checkout was made
# by an external rather than by hand, and the upstream is a public repository.
#
# Like the starship checkout below, this stops a non-interactive apply dead:
#
#   .config/themes/rose-pine/gnome-terminal has changed since chezmoi last
#   wrote it?
#   chezmoi: could not open a new TTY: open /dev/tty: no such device
#
# chezmoi asks before removing a path that drifted, and a git checkout has
# always drifted, because pulling is what the external did. Over ssh there is
# no TTY to answer with, and chezmoi aborts rather than skips, so every target
# sorting after it is left untouched. Remove it by hand first:
#
#   rm -rf ~/.config/themes/rose-pine/gnome-terminal && chezmoi apply
################################################################################

.config/themes/rose-pine/gnome-terminal

################################################################################
# 2026-09-19: the starship fork checkout
#
# ~/.config/starship.toml was a symlink into a clone of
# github.com/xiaosq2000/starship, which carried one committed config per Rosé
# Pine variant. The prompt is now rendered by
# private_dot_config/starship.toml.tmpl from the palette in .chezmoidata, so the
# clone has no reader and Catppuccin variants get a prompt for the first time.
#
# Unconditional, unlike the blocks above, because nothing is lost: the fork is
# a public repository on GitHub and this checkout was created by
# .chezmoiexternal.toml rather than by hand.
#
# chezmoi replaces the old symlink with the rendered file on its own; it is not
# listed here, because removing a path it also manages would delete and
# recreate the prompt config on every apply.
#
# Over ssh this can stop the apply dead:
#
#   .config/themes/rose-pine/starship has changed since chezmoi last wrote it?
#   chezmoi: could not open a new TTY: open /dev/tty: no such device
#
# chezmoi asks before removing a path that drifted, and a git checkout has
# always drifted, because pulling is what the external does. imrl hit this and
# sicc did not, so it depends on whether the clone moved since the last apply.
# The checkout is a clean clone of a public fork, so the answer is always yes:
#
#   rm -rf ~/.config/themes/rose-pine/starship && chezmoi apply
################################################################################

.config/themes/rose-pine/starship
