# Installers this repository used to deploy to ~/.sh_utils/setup.d. Their work
# moved to pixi bundles, dotfiles-fetch and .chezmoiscripts, and an apply that
# left them behind would keep a second, stale way to install the same things.
# Only files this repository wrote are named, because a user may keep helpers
# of their own beside them.
.sh_utils/setup.d/adhd.sh
.sh_utils/setup.d/agent_skills.sh
.sh_utils/setup.d/aider.sh
.sh_utils/setup.d/google_drive_upload.sh
.sh_utils/setup.d/nodejs.sh
.sh_utils/setup.d/pixi.sh
.sh_utils/setup.d/rust.sh
.sh_utils/setup.d/typefaces.sh
.sh_utils/setup.d/zotero.sh
.sh_utils/lib/platform.sh

# The proxy helpers from before the sing-box-manager client. sbc replaced both
# that client and these, and only .bashrc ever loaded them.
.sh_utils/network_management.sh

# lazy.nvim imports every file under plugins/, so a spec this repository
# stopped deploying would keep loading its plugin.
.config/nvim/lua/plugins/tools/floaterm.lua

# Remove the retired writing skill and its shared-agent links so agents cannot
# discover both writing policies after an update.
.agents/skills/plain-writing
.claude/skills/plain-writing
.codex/skills/plain-writing
