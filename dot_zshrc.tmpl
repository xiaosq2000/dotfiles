#!/usr/bin/env zsh
zshrc_start_time=$(date +%s%N)

source ~/.sh_utils/basics.sh
source ~/.sh_utils/helpers.sh
source ~/.sh_utils/checkers.sh
source ~/.sh_utils/tools.sh

# Preferred editors:
if has "nvim"; then
    export SUDO_EDITOR='nvim'
    export EDITOR='nvim'
elif has "vim"; then
    export SUDO_EDITOR='vim'
    export EDITOR='vim'
elif has "vi"; then
    export SUDO_EDITOR='vi'
    export EDITOR='vi'
fi

[[ -n ${EDITOR:-} ]] && export GIT_EDITOR="$EDITOR"

# precmd() {
#     echo;  # Add a newline
# }

# Aliases:
alias zshconfig="${EDITOR} ${HOME}/.zshrc"
alias nvimconfig="${EDITOR} ${XDG_CONFIG_HOME}/nvim"
alias tmuxconfig="${EDITOR} ${XDG_CONFIG_HOME}/tmux"
alias sshconfig="${EDITOR} ${HOME}/.ssh/config"
alias starshipconfig="${EDITOR} ${XDG_CONFIG_HOME}/starship.toml"
alias kittyconfig="${EDITOR} $XDG_CONFIG_HOME/kitty/kitty.conf"
alias alacrittyconfig="${EDITOR} $XDG_CONFIG_HOME/alacritty/alacritty.toml"
alias cl="tput clear"
alias python="python3"
alias lg="lazygit"
alias t="tmux"
alias ta="tmux a"
alias s='web_search google'
alias cdusb='cd /media/$USER/"$(command ls -t /media/$USER/ | head -n1)"'
export ARCHFLAGS="-arch $(uname -m)"
export NUMCPUS=$(grep -c '^processor' /proc/cpuinfo)
alias pmake='time nice make -j${NUMCPUS} --load-average=${NUMCPUS}'

################################################################################
############################## shell behaviour #################################
################################################################################
# What oh-my-zsh's lib/*.zsh used to set. Loading that framework meant 23 MB, a
# plugin loader, an updater polling GitHub behind the prompt and a theme engine
# that starship makes redundant, to get a compinit call and the options below.
# Each one is spelled out here so that none of it arrives as a side effect of
# sourcing something. See ~/.sh_utils/CAVEATS.md
#
# History, from lib/history.zsh.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history       # record start time and duration
setopt hist_expire_dups_first # drop duplicates first when trimming
setopt hist_ignore_dups       # skip a line identical to the one before it
setopt hist_ignore_space      # a leading space keeps a line out of history
setopt hist_verify            # show an expanded line before running it
setopt inc_append_history     # write as lines are entered, not at exit
setopt share_history          # share history between running shells
# HIST_STAMPS="dd/mm/yyyy" configured oh-my-zsh's own `history` wrapper. fc
# prints timestamps without one.
alias history='fc -li'

# Directories, from lib/directories.zsh. Of its aliases, `..` and `...` are the
# ones this shell history actually shows being used, so they are the ones kept.
setopt auto_cd                # a bare directory name means cd
setopt auto_pushd             # keep a directory stack
setopt pushd_ignore_dups
setopt pushd_silent
alias -- ..='cd ..'
alias -- ...='cd ../..'
alias -- ....='cd ../../..'

unsetopt beep

# The rest of what oh-my-zsh set globally, from lib/misc.zsh and
# lib/theme-and-appearance.zsh.
#
# interactive_comments is the one that bites. Without it zsh has no comments on
# the command line, so pasting a documented command that ends in `# explanation`
# passes every word of the explanation as an argument, and the failure names the
# program rather than the paste:
#
#     $ age-keygen -y ~/.config/chezmoi/key.txt    # prints the recipient
#     age-keygen: error: too many arguments
#
# It is also what makes pasting a multi-line snippet with comments work at all.
setopt interactive_comments   # `#` starts a comment on the command line
setopt multios                # allow `echo >file1 >file2`
setopt long_list_jobs         # the long format for job notifications
setopt pushdminus             # `cd -2` counts from the top of the stack
setopt prompt_subst           # expand variables inside PROMPT; starship wants it

# web-search was an oh-my-zsh plugin, and `alias s=` above is the only caller.
# Its implementation needed two more oh-my-zsh library functions; this needs
# none. The opener's output is discarded rather than backgrounded with a bare &,
# which would print a job number over the prompt.
web_search() {
    local engine="${1:-google}" opener terms query
    shift || true
    if [ "$#" -eq 0 ]; then
        printf 'usage: web_search <engine> <terms...>\n' >&2
        printf 'engines: google duckduckgo bing github\n' >&2
        return 1
    fi

    local -A engines=(
        google "https://www.google.com/search?q="
        duckduckgo "https://duckduckgo.com/?q="
        bing "https://www.bing.com/search?q="
        github "https://github.com/search?q="
    )
    if [[ -z ${engines[$engine]:-} ]]; then
        printf 'web_search: unknown engine %s\n' "$engine" >&2
        return 1
    fi

    terms="$*"
    # jq's @uri is a real percent-encoder, and it is right about UTF-8, which
    # matters for searching in Chinese. jq is in the core bundle. The fallback
    # handles the two characters that actually break a search URL, and joining
    # the words with + would not have been enough on its own: a space inside a
    # quoted argument survives the join and is not legal in a URL.
    if has jq; then
        query="$(printf '%s' "$terms" | jq -sRr @uri)"
    else
        query="${terms// /+}"
        query="${query//\//%2F}"
        query="${query//&/%26}"
    fi

    for opener in xdg-open open; do
        if has "$opener"; then
            "$opener" "${engines[$engine]}${query}" >/dev/null 2>&1
            return
        fi
    done
    printf '%s\n' "${engines[$engine]}${query}"
}

################################################################################
##################################### cuda #####################################
################################################################################
prepend_env PATH "/usr/local/cuda/bin"

################################################################################
##################################### pixi #####################################
################################################################################
# https://github.com/prefix-dev/pixi/
# pixi first, then the commands dotfiles-fetch installs from
# .chezmoidata/downloads.toml, such as kitty and tre. Both come before
# ~/.local/bin, so what a machine's bundles select wins over a copy installed
# by hand.
prepend_env PATH "${HOME}/.pixi/bin" "${HOME}/.local/opt/dotfiles/bin"
# Completion is cached to a file on fpath by the completion section further
# down, not loaded here. See ~/.sh_utils/CAVEATS.md

# pnpm (also manages node.js; replaces nvm)
#
# Up here rather than with the other tool sections below, because codex is a
# pnpm binary and the completion cache further down has to find it on PATH
# before compinit runs. Nothing between here and where this block used to sit
# touches PATH, so the order it produces is unchanged: pnpm prepends straight
# after pixi either way, and go, google-drive-upload and opencode still land in
# front of both.
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

################################################################################
##################################### rust #####################################
################################################################################
# Not `. "$HOME/.cargo/env"`: rustup's uninstaller strips that exact string out
# of shell rc files, which leaves a dangling `&&` that swallows the next
# statement. All the file does is put ~/.cargo/bin on PATH. Appending rather
# than prepending also keeps pixi's copies in front of any cargo-installed one.
[ -d "$HOME/.cargo/bin" ] && type append_env >/dev/null 2>&1 && append_env PATH "$HOME/.cargo/bin"

################################################################################
################################### terminal ###################################
################################################################################
set_kitty_as_default() {
    local KITTY_BIN

    if has kitty; then
        KITTY_BIN="$(command -v kitty)"
    elif [ -x "${XDG_PREFIX_HOME}/bin/kitty" ]; then
        KITTY_BIN="${XDG_PREFIX_HOME}/bin/kitty"
    elif [ -x "/usr/bin/kitty" ]; then
        KITTY_BIN="/usr/bin/kitty"
    else
        warning "kitty not found"
        return
    fi

    # For gnome, set kitty as default terminal
    if has gsettings; then
        if gsettings set org.gnome.desktop.default-applications.terminal exec "$KITTY_BIN" 2>/dev/null; then
            debug "Set kitty as default terminal"
        else
            error "Failed to set kitty as default terminal"
        fi
    else
        warning "gsettings not found - cannot set kitty as default terminal"
    fi
}
if [ "$TERM" = "xterm-kitty" ] && has kitten; then
    # Set kitty-scrollback.nvim
    # NOTE: kitty-scrollback.nvim only supports zsh 5.9 or greater for command-line editing,
    autoload -Uz is-at-least
    if is-at-least 5.9; then
        # add the following environment variables to your zsh config (e.g., ~/.zshrc)
        autoload -Uz edit-command-line
        zle -N edit-command-line

        function kitty_scrollback_edit_command_line() {
            local VISUAL='${XDG_DATA_HOME}/nvim/lazy/kitty-scrollback.nvim/scripts/edit_command_line.sh'
            zle edit-command-line
            zle kill-whole-line
        }
        zle -N kitty_scrollback_edit_command_line

        bindkey '^x^e' kitty_scrollback_edit_command_line
        # [optional] pass arguments to kitty-scrollback.nvim in command-line editing mode
        # by using the environment variable KITTY_SCROLLBACK_NVIM_EDIT_ARGS
        # export KITTY_SCROLLBACK_NVIM_EDIT_ARGS=''
    else
        # NOTE: report the version of the shell that is running, not of the zsh
        # on PATH. A pixi-installed zsh shadows the system one for `zsh
        # --version` and `which zsh` while the login shell stays the old system
        # binary, which makes a version-only message look wrong.
        warning "running zsh ${ZSH_VERSION} (< 5.9); skipping kitty-scrollback.nvim command-line integration; zsh on PATH is $(command -v zsh)"
    fi
    # Set kitty's "Truly convenient SSH"
    # NOTE: a function, not an alias. zsh expands an alias before it chooses a
    # completion function, so an alias hands `ssh <TAB>` to kitty's completion,
    # which refused to run under the anchored matchers oh-my-zsh set.
    # NOTE: the inner guard is on the local window variables, not on TERM. A
    # remote shell started by `kitten ssh` also has TERM=xterm-kitty and a copied
    # `kitten` on PATH, so a second hop from there would run a kitten that has no
    # kitty window to talk to. See ~/.sh_utils/CAVEATS.md
    # NOTE: the kitten only when stdin and stdout are both a terminal. It
    # refuses to run otherwise ("The SSH kitten is meant for interactive use
    # only"), and its bootstrap talks to the terminal, so a piped `ssh host cmd`
    # and every AI agent's shell, whose stdin is /dev/null, get plain ssh.
    if [[ -n $KITTY_WINDOW_ID && -n $KITTY_PID ]]; then
        ssh() {
            if [[ -t 0 && -t 1 ]]; then
                kitten ssh "$@"
            else
                command ssh "$@"
            fi
        }
    fi
fi

################################################################################
################## yazi - Blazing fast terminal file manager ###################
########################## https://yazi-rs.github.io/ ##########################
################################################################################
setup_yazi() {
    if has yazi; then
        function y() {
            local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
            yazi "$@" --cwd-file="$tmp"
            if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
                builtin cd -- "$cwd"
            fi
            rm -f -- "$tmp"
        }
    else
        warning "yazi not found."
    fi
}
setup_yazi

################################################################################
###################### fzf - A command-line fuzzy finder #######################
####################### https://junegunn.github.io/fzf/  #######################
################################################################################
setup_fzf() {
    if ! has fzf; then
        warning "fzf not found."
        return
    fi
    # fzf has shipped its own shell integration since 0.48, so `fzf --zsh`
    # prints the key bindings and completion that ~/.config/fzf/fzf.zsh used to
    # hold. That file was written by fzf's own install script, cloned into
    # ~/.fzf by a 96-line setup.d installer. fzf is a conda-forge package and
    # comes from the core bundle now, so neither the clone nor the file exists
    # on a fresh machine.
    source <(fzf --zsh)
    if has kitten; then
        export FZF_CTRL_R_OPTS="--bind 'ctrl-Y:execute-silent(echo -n {2..} | kitten clipboard)' --color header:italic --header 'Press CTRL-Y to copy command into clipboard'"
    elif has wl-copy; then
        export FZF_CTRL_R_OPTS="--bind 'ctrl-Y:execute-silent(echo -n {2..} | wl-copy)' --color header:italic --header 'Press CTRL-Y to copy command into clipboard'"
    elif has xclipboard; then
        export FZF_CTRL_R_OPTS="--bind 'ctrl-Y:execute-silent(echo -n {2..} | xclipboard -selection clipboard)' --color header:italic --header 'Press CTRL-Y to copy command into clipboard'"
    fi
    # Print tree structure in the preview window
    export FZF_ALT_C_OPTS="--walker-skip .git,node_modules,target --preview 'tree -C {}'"
    # FZF_DEFAULT_OPTS, composed from the variant's palette in
    # .chezmoidata/themes-*.toml. The data used to hold the whole option string
    # per variant, four lines of comma-separated pairs that had to be got right
    # by hand; adding a scheme is pasting fourteen hex values now.
    #
    # Sourced rather than rendered here, because this is the one part of a theme
    # switch that cannot reach a shell already running: an exported variable
    # belongs to the shell that exported it, and chezmoi rewriting this file
    # does nothing to the zsh reading it. Behind a fixed name the `theme`
    # wrapper below can re-source it, the same way kitty gets poked over its
    # socket and starship re-reads its config on the next prompt.
    [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/fzf/current-theme.zsh ]] &&
        source ${XDG_CONFIG_HOME:-$HOME/.config}/fzf/current-theme.zsh
}

# `theme` is a script in ~/.local/bin, and a script cannot change the
# environment of the shell that ran it. Everything else a switch touches
# re-reads its own config — starship spawns a fresh process per prompt, kitty is
# poked over its socket, btop and zathura read theirs at startup — so this
# wrapper exists for FZF_DEFAULT_OPTS alone.
#
# Which is also the answer to why `theme` does not exec a new shell: one
# variable is not worth the directory stack, the background jobs, and whatever
# you were half-way through typing. Other shells already open stay stale either
# way, and a new one was always going to be correct.
#
# `command` so this is a wrapper and not a loop. Guarded on success so a typo or
# an abandoned picker does not re-source anything.
theme() {
    command theme "$@" || return
    [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/fzf/current-theme.zsh ]] &&
        source ${XDG_CONFIG_HOME:-$HOME/.config}/fzf/current-theme.zsh
}

################################################################################
###### fzf-tab - Replace zsh's default completion selection menu with fzf ######
###################### https://github.com/Aloxaf/fzf-tab #######################
################################################################################
setup_fzf_tab() {
    # disable sort when completing `git checkout`
    zstyle ':completion:*:git-checkout:*' sort false
    # set descriptions format to enable group support
    # NOTE: don't use escape sequences (like '%F{red}%d%f') here, fzf-tab will ignore them
    zstyle ':completion:*:descriptions' format '[%d]'
    # set list-colors to enable filename colorizing
    zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
    # force zsh not to show completion menu, which allows fzf-tab to capture the unambiguous prefix
    zstyle ':completion:*' menu no
    # Preview directory content during cd completion.
    if has eza; then
        zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
    else
        zstyle ':fzf-tab:complete:cd:*' fzf-preview 'command ls -1 --color=always $realpath'
    fi
    # custom fzf flags
    # NOTE: fzf-tab does not follow FZF_DEFAULT_OPTS by default
    zstyle ':fzf-tab:*' fzf-flags --color=fg:1,fg+:2 --bind=tab:accept
    # To make fzf-tab follow FZF_DEFAULT_OPTS.
    # NOTE: This may lead to unexpected behavior since some flags break this plugin. See Aloxaf/fzf-tab#455.
    zstyle ':fzf-tab:*' use-fzf-default-opts yes
    # switch group using `<` and `>`
    zstyle ':fzf-tab:*' switch-group '<' '>'
}
setup_fzf_tab

# Type 'wt' to see a list of worktrees and cd into the selected one
wt() {
    local dir=$(git worktree list | fzf --height=40% | awk '{print $1}')
    [[ -n "$dir" ]] && cd "$dir"
}

################################################################################
####### zsh-vi-mode - A better and friendly vi(vim) mode plugin for ZSH ########
################## https://github.com/jeffreytse/zsh-vi-mode ###################
################################################################################
# ref: https://github.com/jeffreytse/zsh-vi-mode?tab=readme-ov-file#configuration-function
zvm_config() {
    ZVM_VI_INSERT_ESCAPE_BINDKEY=jk
    ZVM_SYSTEM_CLIPBOARD_ENABLED=true
    # Solve the conflicts with fzf
    # ref: https://github.com/jeffreytse/zsh-vi-mode?tab=readme-ov-file#execute-extra-commands
    zvm_after_init_commands+=('setup_fzf')
}

################################################################################
################################# completion ###################################
################################################################################
# Tool completions, cached to files on fpath rather than evaled at every start.
#
# pixi, codex and uv each print a clap-generated completion script. They are
# large — pixi's is 11,781 lines — and evaluating them cost 516 ms of a 750 ms
# startup, because eval has to parse the whole thing before the prompt can be
# drawn. The same text in a file named for its completion function costs nothing
# here: compinit reads the `#compdef` tag on the first line, and zsh loads the
# body on the first Tab.
#
# Autoloading is what clap emits these for. Each one ends with
#
#   if [ "$funcstack[1]" = "_pixi" ]; then _pixi "$@"; else compdef _pixi pixi; fi
#
# so a single file is correct whether it is autoloaded or sourced, and this block
# does not have to care which.
#
# Regeneration is keyed on the binary being newer than the cache, which is what
# the uv block did before this. It has to be: pixi installs itself, uv comes from
# the pixi manifest and codex from pnpm, and none of them tell chezmoi when they
# move.
_zcompcache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-${ZSH_VERSION}"
[[ -d "$_zcompcache" ]] || mkdir -p "$_zcompcache"

# compinit refuses a directory on fpath that is writable by group or other, and
# checks the parent as well. The umask here is 002, so mkdir leaves both 0775,
# and compinit would then stop on an interactive prompt asking whether to ignore
# them. It does not do that on this laptop, because compaudit exempts a
# group-writable directory when the primary group is named after the user and
# has nobody else in it — which is true here and is not true on sicc, where the
# group is shared. Two stats on a normal start, and the chmod runs once ever.
if [[ -n ${_zcompcache}(#qNf:g+w:,f:o+w:) || -n ${_zcompcache:h}(#qNf:g+w:,f:o+w:) ]]; then
    chmod go-w "${_zcompcache:h}" "$_zcompcache"
fi

typeset -A _zcompgen=(
    pixi  'pixi completion --shell zsh'
    codex 'codex completion zsh'
    uv    'uv generate-shell-completion zsh'
)

for _t in ${(k)_zcompgen}; do
    # $commands is zsh's own hash of external commands, so unlike `has` this
    # costs no fork, and the whole loop is free on a shell whose caches are warm.
    (( ${+commands[$_t]} )) || continue
    _f="$_zcompcache/_$_t"
    [[ -s "$_f" && ! "${commands[$_t]}" -nt "$_f" ]] && continue
    # Written through a temporary, so a tool that fails or is killed halfway
    # cannot leave a truncated file behind. That would break Tab for the command
    # rather than merely leave it uncompleted, and it would persist, because the
    # staleness test above only compares mtimes.
    if eval "${_zcompgen[$_t]}" >|"$_f.new" 2>/dev/null && [[ -s "$_f.new" ]]; then
        mv -f "$_f.new" "$_f"
    else
        rm -f "$_f.new"
    fi
done

fpath=("$_zcompcache" $fpath)

# compinit -C sources the dump and never globs fpath, so a name that is new to
# this directory would go unregistered until the dump ages out, up to a day
# later. Drop the dump and let the compinit below rebuild it.
#
# Deliberately broader than it strictly needs to be. Only a *new* name needs a
# rebuild: the dump records that pixi completes with _pixi, and the body is read
# from fpath at the first Tab, so rewriting a file in place needs nothing here.
# Testing mtimes instead re-dumps after a tool upgrade too, which costs one
# compinit of about 40 ms in one shell. That is cheap enough to be worth not
# having to track which files the loop above created.
#
# .zshrc is in the list because a completion file that is *older* than the dump
# still needs a rebuild the first time this directory joins fpath, and the file's
# own mtime cannot show that — only the apply that rewrote this file can. Note
# `-nt` is false when the dump is missing, which is harmless: compinit rebuilds
# from scratch in that case anyway.
for _f in "$_zcompcache"/_*(N) "${ZDOTDIR:-$HOME}/.zshrc"; do
    [[ "$_f" -nt "$_zcompdump" ]] && { rm -f "$_zcompdump"; break; }
done

unset _t _f _zcompgen _zcompcache

# compinit has to run here: after the zstyles above, and before fzf-tab loads.
#
# The dump goes under XDG rather than ~/.zcompdump, and the security check is
# skipped when the dump is less than a day old, which is what oh-my-zsh's
# lib/completion.zsh did with a cache of its own.
autoload -Uz compinit
if [[ -n ${_zcompdump}(#qNm-1) ]]; then
    compinit -C -d "$_zcompdump"
else
    compinit -d "$_zcompdump"
fi
unset _zcompdump

# Case-insensitive and hyphen-insensitive completion, which is what
# CASE_SENSITIVE="false" and HYPHEN_INSENSITIVE="true" were asking oh-my-zsh
# for.
#
# One unanchored matcher, deliberately. oh-my-zsh set three, of which the second
# and third were anchored, and those are what made kitty's completion stop with
# "ZSH anchored matching active, cannot complete". Losing them costs substring
# completion; it also removes the reason the `ssh` function above exists, though
# that function is still right for the other reason given in CAVEATS.md.
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]-_}={[:upper:][:lower:]_-}'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"

# How completion feels, from oh-my-zsh's lib/completion.zsh. These are habits
# rather than settings: dropping them changes what half-typed words and the tab
# key do, in ways that read as the shell misbehaving.
WORDCHARS=''                  # word motions stop at punctuation
setopt auto_menu              # a second tab opens the completion menu
setopt complete_in_word       # complete from where the cursor is, not the end
setopt always_to_end          # and move the cursor to the end afterwards
unsetopt menu_complete        # do not insert the first match automatically
unsetopt flowcontrol          # ^S and ^Q are not freeze and unfreeze

# fzf-tab's list-colors zstyle above reads LS_COLORS, which oh-my-zsh's
# lib/theme-and-appearance.zsh used to populate. Without it, completion lists
# come out unhighlighted.
if [[ -z ${LS_COLORS:-} ]] && has dircolors; then
    eval "$(dircolors -b)"
fi

################################################################################
################################### plugins ####################################
######################### https://sheldon.cli.rs/ ##############################
################################################################################
# One binary and one file: ~/.config/sheldon/plugins.toml lists the plugins and
# their order, and `sheldon source` prints the source lines. The clones live in
# ~/.local/share/sheldon and are made by `sheldon lock`, which chezmoi runs from
# run_onchange_after_06-sheldon.sh so that starting a shell never touches the
# network.
#
# setup_fzf and zvm_config are defined above this line on purpose: zsh-vi-mode
# calls zvm_config while it loads, and the fzf bindings have to be reapplied
# from zvm_after_init_commands afterwards.
if has sheldon; then
    eval "$(sheldon source)"
else
    warning "sheldon not found; no zsh plugins are loaded."
    hint "it comes from the core bundle; check .chezmoidata/machines.toml"
fi

# eza
if has eza; then
    alias ls='eza --group-directories-first --icons=auto'
    alias la='eza -a --group-directories-first --icons=auto'
    alias ll='eza -la --group-directories-first --icons=auto --git'
    alias lt='eza --tree --level=2 --icons=auto'
fi

# pnpm's PATH entry is set up with pixi's, far above, because codex is a pnpm
# binary and the completion cache has to see it before compinit runs.

# go
prepend_env PATH "${HOME}/.local/go/bin"

# deno
[ -f "$HOME/.deno/env" ] && \. "$HOME/.deno/env"

# starship
if has starship; then eval "$(starship init zsh)"; fi

# google-drive-upload
prepend_env PATH "${HOME}/.google-drive-upload/bin"

# tre
if has tre; then
    tre() { command tre "$@" -e && source "/tmp/tre_aliases_$USER" 2>/dev/null; }
fi

# uv, pixi and codex completions are cached to files on fpath in the completion
