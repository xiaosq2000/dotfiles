{{- /*
   The downloads this machine selects, for dotfiles-fetch. chezmoi only renders
   this file; run_onchange_after_90-downloads.sh runs `dotfiles-fetch sync`
   whenever it changes, and nothing here touches the network.
*/ -}}
{{- $selection := includeTemplate "software-selection" . | fromJson -}}
{{- $resources := dict -}}
{{- range $id := $selection.downloads -}}
{{-   $_ := set $resources $id (index $.downloads $id) -}}
{{- end -}}
{{- dict
      "comment" "Generated by chezmoi from .chezmoidata/downloads.toml; edits here are lost on the next apply."
      "platform" (printf "%s-%s" .chezmoi.os .chezmoi.arch)
      "resources" $resources
    | toPrettyJson }}
