{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "~/.local/texlive": "deny",
      "~/.local/texlive/**": "deny"
    },
    "external_directory": {
      "~/.local/texlive": "allow",
      "~/.local/texlive/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.config/chezmoi/key.txt": "deny",
      "~/.ssh/*": "deny",
      "~/.ssh/*.pub": "allow",
      "~/.ssh/authorized_keys*": "allow",
      "~/.ssh/config*": "allow",
      "~/.ssh/known_hosts*": "allow"
    }
  },
  "plugin": [
    "@slkiser/opencode-quota",
    "@mohak34/opencode-notifier@latest"
  ],
  "provider": {
    "openai": {}
  }
}
