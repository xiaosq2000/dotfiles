{{- $t := index .themes .theme -}}
{{- $s := index .schemes $t.scheme -}}
{{- /*
Starship prompt, rendered from theme data.

Minimalist two-line layout with typographic hierarchy. Colors come from
.chezmoidata so the layout serves every theme.

Scheme: {{ $s.description }}
Variant: {{ .theme }} — {{ $t.description }} ({{ $t.appearance }})
*/ -}}
"$schema" = 'https://starship.rs/config-schema.json'

format = """
$directory\
$git_branch\
$git_status\
$container\
$c\
$elixir\
$elm\
$golang\
$haskell\
$java\
$julia\
$nodejs\
$nim\
$rust\
$scala\
$conda\
$python\
$fill\
$cmd_duration\
$hostname\
$time\
$line_break\
$character\
"""

palette = "{{ .theme }}"

# Rendered from [themes.{{ .theme }}.starship] in .chezmoidata. Every colour the
# config below names is named for its role, never for a scheme, which is what
# lets one template serve Rosé Pine and Catppuccin alike.
[palettes.{{ .theme }}]
{{ range $role := list "surface" "error" "warn" "accent" "lang" "vcs" "primary" -}}
{{ $role }} = {{ index $t.starship $role | quote }}
{{ end }}
[character]
success_symbol = "[❯](bold fg:primary) "
error_symbol = "[❯](bold fg:error) "

[directory]
format = "[$path]($style) "
style = "bold fg:lang"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
Documents = "󰈙"
Downloads = " "
Music = " "
Pictures = " "

[git_branch]
format = "[on](dimmed) [$symbol $branch]($style) "
style = "fg:{{ if eq $t.appearance "light" }}lang{{ else }}vcs{{ end }}"
symbol = ""

[git_status]
style = "fg:warn"
format = '([\[$all_status$ahead_behind\]]($style) )'
up_to_date = ""
untracked = "?"
stashed = '\$'
modified = "!"
renamed = "»"
deleted = "✘"
staged = "+"
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"

[fill]
symbol = " "

[cmd_duration]
min_time = 2_000
format = "[took](dimmed) [$duration](italic fg:accent) "

[hostname]
ssh_only = true
ssh_symbol = "󰒋 "
format = "[$ssh_symbol$hostname](bold fg:primary) "
style = "bold fg:primary"

[time]
disabled = false
format = "[󰥔 $time](dimmed fg:accent)"
time_format = "%H:%M"
use_12hr = false

[container]
format = "[in](dimmed) [$symbol $name]($style) "
style = "fg:accent"

# Languages

[c]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = " "

[elixir]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = " "

[elm]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = " "

[golang]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = " "

[haskell]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = " "

[java]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = " "

[julia]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = " "

[nodejs]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = "󰎙 "

[nim]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
symbol = "󰆥 "

[rust]
style = "fg:lang"
format = "[via](dimmed) [$symbol$version]($style) "
disabled = false
