{{- $selection := includeTemplate "software-selection" . | fromJson -}}
# GENERATED FILE from .chezmoidata/mise.toml and .chezmoidata/tools.toml.
# Machine: {{ .machine }} — {{ (index .machines .machine).description }}
# Edits in ~ are overwritten by the next `chezmoi apply`.

[settings]
locked = false
lockfile = false
# Keep mise's default release-age cooldown for third-party tools, but let our
# own CLI releases install immediately after tagging cli-v*.
minimum_release_age_excludes = ["github:xiaosq2000/dotfiles"]
status = { missing_tools = "never", show_env = false, show_tools = false }
{{ if $selection.mise }}
[tools]
{{- range $id := $selection.mise }}
{{-   $spec := index $.mise $id }}
{{-   $ver := get $spec "version" | default "latest" }}
{{-   if hasKey $spec "version_prefix" }}
{{ $spec.tool | quote }} = { version = {{ $ver | quote }}, version_prefix = {{ $spec.version_prefix | quote }} }
{{-   else }}
{{ $spec.tool | quote }} = {{ $ver | quote }}
{{-   end }}
{{- end }}
{{ end -}}
