# Managed by chezmoi. Reload with `Prefix + r`.

################################################################################
# Shell and core behaviour
################################################################################
# Resolve the managed pixi zsh first, falling back to system zsh so shared HPC
# nodes without /bin/zsh work out of the box.
if-shell '[ -x "{{ .chezmoi.homeDir }}/.pixi/bin/zsh" ]' \
    'set-option -g default-shell "{{ .chezmoi.homeDir }}/.pixi/bin/zsh"' \
    'if-shell "[ -x /usr/bin/zsh ]" "set-option -g default-shell /usr/bin/zsh"'

bind r source-file "{{ .chezmoi.homeDir }}/.config/tmux/tmux.conf" \; display "tmux.conf reloaded"

set -sg escape-time 0
set -g base-index 1
set -gw pane-base-index 1
set -g renumber-windows on
set -g history-limit 50000
set -g focus-events on
set -g mouse on

# Keep SSH and desktop display variables fresh on reattach without injecting
# commands into live panes.
set -g update-environment "DISPLAY WAYLAND_DISPLAY XAUTHORITY SSH_AUTH_SOCK SSH_AGENT_PID SSH_CONNECTION KRB5CCNAME XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE"

# Intuitive pane splits at the current working directory.
unbind '"'
unbind %
bind | split-window -h -c "#{pane_current_path}"
bind _ split-window -v -c "#{pane_current_path}"

################################################################################
# Terminal capabilities and OSC 52 clipboard
################################################################################
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-256color:RGB,xterm-kitty:RGB,*:clipboard,*:hyperlinks,*:usstyle"
set -g allow-passthrough on
set -g set-clipboard on
set -g extended-keys on

################################################################################
# Copy mode (vi keys, native OSC 52 clipboard works on Wayland, X11 and SSH)
################################################################################
set -gw mode-keys vi
unbind [
bind Escape copy-mode
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
unbind p
bind p paste-buffer

################################################################################
# Theme (rendered from .chezmoidata/themes-*.toml; reloaded by `theme`)
################################################################################
source-file -q "{{ .chezmoi.homeDir }}/.config/tmux/current-theme.conf"

################################################################################
# Optional TPM plugins (Prefix + I to install; skipped cleanly when absent)
################################################################################
set-environment -g TMUX_PLUGIN_MANAGER_PATH "{{ .chezmoi.homeDir }}/.local/share/tmux/plugins"
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-resurrect'

# Clear with prefix, avoiding conflicts with vim-tmux-navigator.
bind C-l send-keys 'C-l'

if-shell '[ -x "{{ .chezmoi.homeDir }}/.local/share/tmux/plugins/tpm/tpm" ]' \
    'run "{{ .chezmoi.homeDir }}/.local/share/tmux/plugins/tpm/tpm"'
