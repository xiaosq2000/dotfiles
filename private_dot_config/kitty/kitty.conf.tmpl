# chezmoi:template:left-delimiter=[[ right-delimiter=]]
# vim:fileencoding=utf-8:ft=kitty

# Theme: [[ .theme ]] — [[ (index .themes .theme).kittyName ]]
include current-theme.conf

# Fonts
font_family      family=[[ .typography.terminalFamily | quote ]]
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        16.0

# Cursor & appearance
cursor_blink_interval -1
custom_shaders        cursor-trail-blaze
cursor_trail          1
background_opacity    1
background_image      none
dim_opacity           0.7

# Layouts & tabs
enabled_layouts     splits,stack
tab_bar_style       powerline
tab_bar_min_tabs    1
tab_powerline_style slanted
tab_title_template  "{title}{' :{}:'.format(num_windows) if num_windows > 1 else ''}"

# Remote control (socket-only so TTY escape sequences cannot control windows)
allow_remote_control socket-only
listen_on            unix:/tmp/kitty
shell_integration    enabled
linux_display_server auto

# Window navigation (yields to Neovim when IS_VIM=true)
map ctrl+h neighboring_window left
map ctrl+j neighboring_window down
map ctrl+k neighboring_window up
map ctrl+l neighboring_window right
map --when-focus-on var:IS_VIM=true ctrl+h
map --when-focus-on var:IS_VIM=true ctrl+j
map --when-focus-on var:IS_VIM=true ctrl+k
map --when-focus-on var:IS_VIM=true ctrl+l

# Splits & detach
map ctrl+a       launch --location=vsplit --cwd=current
map ctrl+shift+d launch --location=hsplit --cwd=current
map ctrl+shift+y layout_action rotate
map ctrl+f2      detach_window
map ctrl+f3      detach_window new-tab

# kitty-scrollback.nvim (include pixi and dotfiles-fetch bins so desktop-launched
# kitty resolves the managed nvim instead of /usr/bin/nvim)
exe_search_path [[ .chezmoi.homeDir ]]/.pixi/bin [[ .chezmoi.homeDir ]]/.local/opt/dotfiles/bin [[ .chezmoi.homeDir ]]/.local/bin
action_alias kitty_scrollback_nvim kitten ~/.local/share/nvim/lazy/kitty-scrollback.nvim/python/kitty_scrollback_nvim.py
map kitty_mod+h kitty_scrollback_nvim
map kitty_mod+/ kitty_scrollback_nvim
map kitty_mod+g kitty_scrollback_nvim --config ksb_builtin_last_cmd_output
mouse_map ctrl+shift+right press ungrabbed combine : mouse_select_command_output : kitty_scrollback_nvim --config ksb_builtin_last_visited_cmd_output
