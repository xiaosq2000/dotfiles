{{- $c := (index .themes .theme).fzf -}}
# fzf's colours for {{ .theme }} — {{ (index .themes .theme).description }}.
#
# Generated from [themes.{{ .theme }}.fzf] in .chezmoidata/themes-*.toml.
#
# A fixed name, like ~/.config/btop/themes/current.theme and
# ~/.config/kitty/current-theme.conf, so nothing that reads it has to mention a
# variant. This string used to be rendered straight into setup_fzf() in
# dot_zshrc.tmpl, which worked but left FZF_DEFAULT_OPTS as the one thing a
# `theme` switch could not reach: an exported variable belongs to the shell that
# exported it, and chezmoi rewriting the zshrc does nothing to a zsh already
# running. Now `theme` rewrites this file and the wrapper around it re-sources
# it, so the switch lands in the shell you ran it from.
export FZF_DEFAULT_OPTS="--color=fg:{{ $c.fg }},bg:{{ $c.bg }},hl:{{ $c.hl }} --color=fg+:{{ $c.fgPlus }},bg+:{{ $c.bgPlus }},hl+:{{ $c.hlPlus }} --color=border:{{ $c.border }},header:{{ $c.header }},gutter:{{ $c.gutter }} --color=spinner:{{ $c.spinner }},info:{{ $c.info }} --color=pointer:{{ $c.pointer }},marker:{{ $c.marker }},prompt:{{ $c.prompt }}"
