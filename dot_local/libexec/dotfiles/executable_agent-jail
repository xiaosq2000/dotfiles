#!/usr/bin/env python3
"""Run a coding agent or shell command inside an OS-level capability sandbox.

Enforces the secret-protection policy declared in .chezmoidata/policy.toml
(deployed to ~/.config/dotfiles/policy.json):
  - Filesystem root is read-only; only the workspace (--workspace, default $PWD),
    /tmp, common caches, and the invoked agent's own state directory are writable.
  - Workspace .git/hooks and .git/config remain read-only.
  - SSH private keys (~/.ssh/* except config, known_hosts*, authorized_keys*,
    config.d, and *.pub), the chezmoi age identity (~/.config/chezmoi/key.txt),
    ~/.secrets, cloud/CLI credential files, and OTHER agents' auth files are
    masked at the OS level so no subprocess or runtime-computed path can read them.
  - SSH_AUTH_SOCK (if set) is passed through so ssh / git push continue working
    via ssh-agent without exposing private key files.

Backends:
  bwrap     Linux bubblewrap mount namespace (default when available and permitted)
  landlock  Linux Landlock LSM (ABI v1+, rootless fallback for HPC login nodes
            where unprivileged user namespaces are disabled)
"""

import argparse
import ctypes
import json
import os
from pathlib import Path
import shutil
import struct
import subprocess
import sys

