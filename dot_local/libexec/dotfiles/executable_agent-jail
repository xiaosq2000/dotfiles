META_FLAGS = {"-h", "--help", "-v", "-V", "--version"}


def is_passthrough(agent, args):
    """Return True if agent args represent a help/version/management command."""
    if not agent or not args:
        return False
    first = args[0]
    if first in META_FLAGS:
        return True
    subs = PASSTHROUGH_SUBCOMMANDS.get(agent) or set()
    if first in subs:
        return True
    if agent == "codex" and first.startswith("migrate-"):
        return True
    return False


def extract_codex_paths(args):
    """Extract -C/--cd workspace and --add-dir extra RW dirs from codex args."""
    inferred_ws = None
    extra_rw = []
    i = 0
    while i < len(args):
        tok = args[i]
        if tok == "--":
            break
        if tok in ("-C", "--cd") and i + 1 < len(args):
            inferred_ws = args[i + 1]
            i += 2
            continue
        if tok.startswith("--cd="):
            inferred_ws = tok.split("=", 1)[1]
            i += 1
            continue
        if tok == "--add-dir" and i + 1 < len(args):
            extra_rw.append(args[i + 1])
            i += 2
            continue
        if tok.startswith("--add-dir="):
            extra_rw.append(tok.split("=", 1)[1])
            i += 1
            continue
        i += 1
    return inferred_ws, extra_rw


def _codex_has_explicit_sandbox(args):
    i = 0
    while i < len(args):
        tok = args[i]
        if tok == "--":
            break
        if tok in ("-s", "--sandbox", "--dangerously-bypass-approvals-and-sandbox"):
            return True
        if tok.startswith("--sandbox="):
            return True
        if tok in ("-c", "--config") and i + 1 < len(args):
            if "sandbox_mode" in args[i + 1]:
                return True
            i += 2
            continue
        if tok.startswith("--config=") and "sandbox_mode" in tok:
            return True
        i += 1
    return False


def _codex_has_explicit_daemon_flag(args):
    for tok in args:
        if tok == "--":
            break
        if tok in ("--no-daemon", "--remote") or tok.startswith("--remote="):
            return True
    return False


def adapt_agent_cmd(cmd, jailed, wrap_mode):
    """Adjust agent argv for jailed/wrapped execution without breaking explicit user flags."""
    if not cmd:
        return list(cmd)
    binary_agent = AGENT_ALIASES.get(Path(cmd[0]).name.lower())
    if not binary_agent or is_passthrough(binary_agent, cmd[1:]):
        return list(cmd)
    args = list(cmd[1:])
    if binary_agent == "agy" and wrap_mode:
        if "--dangerously-skip-permissions" not in args:
            args.insert(0, "--dangerously-skip-permissions")
        return [cmd[0], *args]
    if binary_agent == "codex" and jailed:
        # Linux bwrap cannot nest inside our outer agent-jail bwrap namespace,
        # and the empty /tmp mount hides the host app-server daemon socket
        # (connecting to an unjailed host daemon with danger-full-access would
        # also bypass both sandboxes). Disable Codex's inner sandbox and host
        # daemon while keeping gh.rules approval checks; outer agent-jail
        # enforces OS-level isolation.
        prefix = []
        if not _codex_has_explicit_sandbox(args):
            prefix.extend(["-s", "danger-full-access"])
        if not _codex_has_explicit_daemon_flag(args):
            prefix.append("--no-daemon")
        return [cmd[0], *prefix, *args]
    return list(cmd)


def load_policy(policy_path=None):
    candidates = []
    if policy_path:
        candidates.append(Path(policy_path))
    else:
        xdg = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
        candidates.append(xdg / "dotfiles/policy.json")
    for path in candidates:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(data, dict) and "secrets" in data and "jail" in data:
                return data
        except (OSError, ValueError):
            pass
    return DEFAULT_POLICY


def detect_agent(cmd, explicit):
    if explicit == "none":
        return None
    if explicit and explicit != "auto":
        return explicit
    if not cmd:
        return None
    return AGENT_ALIASES.get(Path(cmd[0]).name.lower())


def resolve_git_dir(workspace):
    dot_git = workspace / ".git"
    if dot_git.is_dir():
        return dot_git
    if dot_git.is_file():
        try:
            first = dot_git.read_text(encoding="utf-8").strip()
            if first.startswith("gitdir:"):
                target = Path(first.split(":", 1)[1].strip())
                if not target.is_absolute():
                    target = (workspace / target).resolve()
                return target
        except OSError:
            pass
    return None


def collect_plan(home, workspace, extra_rw, agent, policy, mask_gh=False):
    secrets = policy["secrets"]
    jail = policy["jail"]
    agent_cfg = (jail.get("agents") or {}).get(agent) or {}
    own_auth = {home / rel for rel in agent_cfg.get("own_auth_files") or []}

    rw_dirs = [workspace]
    for path in extra_rw:
        p = Path(path).expanduser().resolve()
        if p.exists():
            rw_dirs.append(p)
    for rel in jail.get("common_rw_dirs") or []:
        p = home / rel
        if p.exists():
            rw_dirs.append(p)
    for abs_dir in jail.get("machine_rw_dirs") or []:
        p = Path(abs_dir).expanduser()
        if p.exists():
            rw_dirs.append(p.resolve())
    for rel in agent_cfg.get("rw_dirs") or []:
        p = home / rel
        if p.exists():
            rw_dirs.append(p)

    rw_files = []
    for rel in agent_cfg.get("rw_files") or []:
        p = home / rel
        if p.exists() and not p.is_dir():
            rw_files.append(p)

    # Protect workspace .git/hooks and .git/config from tampering.
    ro_overrides = []
    git_dir = resolve_git_dir(workspace)
    if git_dir and git_dir.is_dir():
        if git_dir != workspace / ".git":
            # Git worktree: the shared gitdir sits outside workspace; allow git
            # metadata writes there while still keeping hooks/config read-only.
            rw_dirs.append(git_dir)
        for name in ("hooks", "config"):
            target = git_dir / name
            if target.exists():
                ro_overrides.append(target)

    # Sensitive files and directories to mask at the OS level.
    masked_dirs = []
    for rel in secrets.get("masked_dirs") or []:
        p = home / rel
        if p.is_dir():
            masked_dirs.append(p)

    masked_files = []
    mask_list = list(secrets.get("masked_files") or [])
    if mask_gh and ".config/gh/hosts.yml" not in mask_list:
        mask_list.append(".config/gh/hosts.yml")
    for rel in mask_list:
        p = home / rel
        if p in own_auth:
            continue
        if p.exists() and not p.is_dir():
            masked_files.append(p)

    # Every non-public file under ~/.ssh/ is treated as a private key.
    ssh_dir = home / ".ssh"
    public_names = set(secrets.get("ssh_public_names") or [])
    public_dirs = set(secrets.get("ssh_public_dirs") or [])
    if ssh_dir.is_dir():
        try:
            for child in sorted(ssh_dir.iterdir()):
                if child.name in public_names or child.name.endswith(".pub"):
                    continue
                if child.is_dir() and child.name in public_dirs:
                    continue
                if child.is_dir():
                    masked_dirs.append(child)
                else:
                    masked_files.append(child)
        except OSError:
            pass

    hide_system_dirs = [Path(p) for p in (jail.get("hide_system_dirs") or []) if Path(p).is_dir()]

    # Deduplicate preserving order.
    def dedupe(items):
        seen, out = set(), []
        for item in items:
            key = str(item)
            if key not in seen:
                seen.add(key)
                out.append(item)
        return out

    return {
        "home": home,
        "workspace": workspace,
        "agent": agent,
        "rw_dirs": dedupe(rw_dirs),
        "rw_files": dedupe(rw_files),
        "ro_overrides": dedupe(ro_overrides),
        "masked_dirs": dedupe(masked_dirs),
        "masked_files": dedupe(masked_files),
        "hide_system_dirs": dedupe(hide_system_dirs),
    }


def build_bwrap_argv(plan, cmd, env):
    argv = [
        "bwrap",
        "--die-with-parent",
        "--ro-bind", "/", "/",
        "--dev", "/dev",
        "--proc", "/proc",
        "--tmpfs", "/tmp",
    ]

    # Re-expose runtime sockets that live under /tmp (e.g., ssh-agent, Herdr).
    for sock_var in ("SSH_AUTH_SOCK", "HERDR_SOCKET_PATH"):
        raw = env.get(sock_var)
        if not raw:
            continue
        sock = Path(raw)
        if sock.exists() and str(sock).startswith("/tmp/"):
            argv.extend(["--bind", str(sock), str(sock)])

    # Allow X11/XWayland socket connections (read-only dir) when DISPLAY is set.
    if env.get("DISPLAY") and Path("/tmp/.X11-unix").is_dir():
        argv.extend(["--ro-bind", "/tmp/.X11-unix", "/tmp/.X11-unix"])

    # When HOME lives under /tmp (e.g., disposable test homes), re-bind it RO
    # after `--tmpfs /tmp` so masks and workspace binds inside it take effect.
    if str(plan["home"]).startswith("/tmp/"):
        argv.extend(["--ro-bind", str(plan["home"]), str(plan["home"])])

    # Ensure XDG_RUNTIME_DIR sockets (ssh-agent, dbus, wayland) remain reachable.
    runtime_dir = env.get("XDG_RUNTIME_DIR")
    if runtime_dir and Path(runtime_dir).is_dir():
        argv.extend(["--bind", runtime_dir, runtime_dir])

    for path in plan["rw_dirs"]:
        argv.extend(["--bind", str(path), str(path)])

    for path in plan["rw_files"]:
        argv.extend(["--bind", str(path), str(path)])

    for path in plan["ro_overrides"]:
        argv.extend(["--ro-bind", str(path), str(path)])

    for path in plan["hide_system_dirs"]:
        argv.extend(["--tmpfs", str(path)])

    for path in plan["masked_dirs"]:
        argv.extend(["--tmpfs", str(path)])

    for path in plan["masked_files"]:
        argv.extend(["--ro-bind", "/dev/null", str(path)])

    argv.extend(["--chdir", str(plan["workspace"]), "--", *cmd])
    return argv


def bwrap_available():
    if not shutil.which("bwrap"):
        return False
    try:
        res = subprocess.run(
            ["bwrap", "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--", "/bin/true"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
        return res.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


# --------------------------------------------------------------------------
# Linux Landlock LSM backend (rootless fallback when bwrap is unavailable)
# --------------------------------------------------------------------------

SYS_LANDLOCK_CREATE_RULESET = 444
SYS_LANDLOCK_ADD_RULE = 445
SYS_LANDLOCK_RESTRICT_SELF = 446
PR_SET_NO_NEW_PRIVS = 38
LANDLOCK_CREATE_RULESET_VERSION = 1
LANDLOCK_RULE_PATH_BENEATH = 1

LL_EXECUTE = 1 << 0
LL_WRITE_FILE = 1 << 1
LL_READ_FILE = 1 << 2
LL_READ_DIR = 1 << 3
LL_REFER = 1 << 13
LL_TRUNCATE = 1 << 14
LL_ABI_V1_ALL = (1 << 13) - 1


def _libc():
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long
    return libc


def landlock_abi_version():
    if not sys.platform.startswith("linux"):
        return 0
    try:
        libc = _libc()
        abi = libc.syscall(
            ctypes.c_long(SYS_LANDLOCK_CREATE_RULESET),
            ctypes.c_void_p(0),
            ctypes.c_size_t(0),
            ctypes.c_uint32(LANDLOCK_CREATE_RULESET_VERSION),
        )
        return int(abi) if abi > 0 else 0
    except Exception:
        return 0


def _ancestors(path):
    cur = path.parent
    out = set()
    while True:
        out.add(cur)
        if cur == cur.parent:
            break
        cur = cur.parent
    return out


def compute_landlock_rules(plan):
    """Return [(path, mode), ...] where mode is 'ro' or 'rw'.

    Walks from / downward, expanding only ancestor directories of any masked or
    differently-permissioned target so forbidden files/dirs receive zero rules.
    """
    forbidden = {p.resolve() for p in plan["masked_dirs"] + plan["masked_files"]}
    rw_roots = {p.resolve() for p in plan["rw_dirs"] + plan["rw_files"]}
    for extra in (Path("/tmp"), Path("/dev")):
        if extra.exists():
            rw_roots.add(extra.resolve())
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir and Path(runtime_dir).is_dir():
        rw_roots.add(Path(runtime_dir).resolve())

    # Landlock rules are purely additive (no negative mount overrides), so
    # ro_overrides inside rw_roots (like workspace/.git/hooks) are enforced by
    # the bwrap backend; Landlock still enforces RO root, RW workspace, and full
    # secret-file/directory read denial.
    home_resolved = plan["home"].resolve()
    special = forbidden | rw_roots | {home_resolved}
    expand_dirs = set()
    for target in special:
        expand_dirs |= _ancestors(target)

    rules = []

    def walk(path, inherited_mode):
        try:
            resolved = path.resolve(strict=False)
        except OSError:
            return
        if resolved in forbidden:
            return

        mode = inherited_mode
        if resolved == home_resolved:
            mode = "ro"
        if resolved in rw_roots:
            mode = "rw"

        if resolved in expand_dirs and path.is_dir() and not path.is_symlink():
            # Allow directory listing only when no forbidden child sits directly inside
            # (or wait: listing ~/.ssh or ~/.config is fine, reading private keys is denied;
            # never grant READ_DIR on a forbidden dir itself, which already returned above).
            try:
                children = sorted(path.iterdir())
            except OSError:
                return
            for child in children:
                walk(child, mode)
            return

        rules.append((path, mode))

    walk(Path("/"), "ro")
    return rules


def apply_landlock_and_exec(plan, cmd, env):
    abi = landlock_abi_version()
    if abi < 1:
        raise RuntimeError("Linux Landlock LSM is not available on this kernel")

    handled = LL_ABI_V1_ALL
    if abi >= 2:
        handled |= LL_REFER
    if abi >= 3:
        handled |= LL_TRUNCATE

    ro_dir_access = LL_EXECUTE | LL_READ_FILE | LL_READ_DIR
    ro_file_access = LL_EXECUTE | LL_READ_FILE
    rw_dir_access = handled
    rw_file_access = LL_EXECUTE | LL_READ_FILE | LL_WRITE_FILE | (LL_TRUNCATE if abi >= 3 else 0)

    libc = _libc()
    attr_buf = ctypes.create_string_buffer(struct.pack("<Q", handled))
    ruleset_fd = libc.syscall(
        ctypes.c_long(SYS_LANDLOCK_CREATE_RULESET),
        attr_buf,
        ctypes.c_size_t(8),
        ctypes.c_uint32(0),
    )
    if ruleset_fd < 0:
        err = ctypes.get_errno()
        raise OSError(err, f"landlock_create_ruleset failed: {os.strerror(err)}")

    o_path = getattr(os, "O_PATH", 0x200000)
    try:
        for path, mode in compute_landlock_rules(plan):
            try:
                fd = os.open(str(path), o_path | os.O_CLOEXEC)
            except OSError:
                continue
            try:
                is_dir = path.is_dir()
                if mode == "rw":
                    access = rw_dir_access if is_dir else rw_file_access
                else:
                    access = ro_dir_access if is_dir else ro_file_access
                rule_buf = ctypes.create_string_buffer(struct.pack("<Qi", access, fd))
                rc = libc.syscall(
                    ctypes.c_long(SYS_LANDLOCK_ADD_RULE),
                    ctypes.c_int(ruleset_fd),
                    ctypes.c_int(LANDLOCK_RULE_PATH_BENEATH),
                    rule_buf,
                    ctypes.c_uint32(0),
                )
                if rc < 0:
                    err = ctypes.get_errno()
                    raise OSError(err, f"landlock_add_rule({path}) failed: {os.strerror(err)}")
            finally:
                os.close(fd)

        if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
            err = ctypes.get_errno()
            raise OSError(err, f"prctl(PR_SET_NO_NEW_PRIVS) failed: {os.strerror(err)}")

        if libc.syscall(ctypes.c_long(SYS_LANDLOCK_RESTRICT_SELF), ctypes.c_int(ruleset_fd), ctypes.c_uint32(0)) != 0:
            err = ctypes.get_errno()
            raise OSError(err, f"landlock_restrict_self failed: {os.strerror(err)}")
    finally:
        os.close(ruleset_fd)

    os.chdir(plan["workspace"])
    os.execvpe(cmd[0], cmd, env)


def main():
    parser = argparse.ArgumentParser(
        description="Run a coding agent or command inside an OS-level sandbox (bwrap or Landlock)."
    )
    parser.add_argument("--workspace", default=None, help="Writable workspace directory (default: current directory)")
    parser.add_argument("--rw", action="append", default=[], help="Additional writable directory (repeatable)")
    parser.add_argument(
        "--agent",
        choices=("auto", "none", "claude", "codex", "agy", "pi"),
        default="auto",
        help="Agent profile whose own state/auth stays accessible (default: auto-detect from command)",
    )
    parser.add_argument(
        "--wrap",
        choices=("claude", "codex", "agy", "pi"),
        default=None,
        help="Default-wrapper mode for an interactive coding agent (prepends binary and applies agent defaults)",
    )
    parser.add_argument(
        "--backend",
        choices=("auto", "bwrap", "landlock"),
        default="auto",
        help="Sandbox backend (default: auto -> bwrap, then landlock)",
    )
    parser.add_argument("--policy", default=None, help="Path to policy.json (default: ~/.config/dotfiles/policy.json)")
    parser.add_argument(
        "--mask-gh",
        action="store_true",
        help="Also mask ~/.config/gh/hosts.yml inside the sandbox (or set DOTFILES_JAIL_MASK_GH=1)",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Force entering the sandbox even when DOTFILES_AGENT_JAIL=1 is already set",
    )
    parser.add_argument("--dry-run", action="store_true", help="Print the sandbox plan/command without executing")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="Command to execute (prefix with -- if it has flags)")
    args = parser.parse_args()

    cmd = list(args.command)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    wrap_mode = bool(args.wrap)
    if wrap_mode:
        cmd = [args.wrap, *cmd]
    if not cmd:
        parser.error("a command is required (e.g., agent-jail codex or agent-jail -- bash)")

    agent = args.wrap if wrap_mode else detect_agent(cmd, args.agent)

    if not args.dry_run:
        if wrap_mode and is_passthrough(agent, cmd[1:]):
            os.execvp(cmd[0], cmd)
        if os.environ.get("DOTFILES_NO_JAIL") == "1":
            final_cmd = adapt_agent_cmd(cmd, jailed=False, wrap_mode=wrap_mode)
            os.execvp(final_cmd[0], final_cmd)
        if os.environ.get("DOTFILES_AGENT_JAIL") == "1" and not args.force:
            final_cmd = adapt_agent_cmd(cmd, jailed=True, wrap_mode=wrap_mode)
            os.execvp(final_cmd[0], final_cmd)

    inferred_ws = None
    codex_rw = []
    if AGENT_ALIASES.get(Path(cmd[0]).name.lower()) == "codex":
        inferred_ws, codex_rw = extract_codex_paths(cmd[1:])

    env_rw = [p for p in os.environ.get("DOTFILES_JAIL_RW", "").split(os.pathsep) if p]
    extra_rw = [*args.rw, *env_rw, *codex_rw]

    home = Path.home().resolve()
    if args.workspace:
        workspace = Path(args.workspace).expanduser().resolve()
    elif inferred_ws and Path(inferred_ws).expanduser().is_dir():
        workspace = Path(inferred_ws).expanduser().resolve()
    else:
        workspace = Path.cwd().resolve()

    policy = load_policy(args.policy)
    mask_gh = bool(args.mask_gh or os.environ.get("DOTFILES_JAIL_MASK_GH") == "1")
    cmd = adapt_agent_cmd(cmd, jailed=True, wrap_mode=wrap_mode)
    plan = collect_plan(home, workspace, extra_rw, agent, policy, mask_gh=mask_gh)

    backend = args.backend
    if backend == "auto":
        if bwrap_available():
            backend = "bwrap"
        elif landlock_abi_version() >= 1:
            backend = "landlock"
        else:
            sys.stderr.write(
                "agent-jail: error: neither bwrap nor Linux Landlock is available "
                "(bypass with DOTFILES_NO_JAIL=1 or unjail)\n"
            )
            return 1

    env = os.environ.copy()
    env["DOTFILES_AGENT_JAIL"] = "1"
    env["DOTFILES_AGENT_JAIL_BACKEND"] = backend

    if args.dry_run:
        summary = {
            "backend": backend,
            "agent": agent,
            "workspace": str(plan["workspace"]),
            "rw_dirs": [str(p) for p in plan["rw_dirs"]],
            "rw_files": [str(p) for p in plan["rw_files"]],
            "ro_overrides": [str(p) for p in plan["ro_overrides"]],
            "masked_dirs": [str(p) for p in plan["masked_dirs"]],
            "masked_files": [str(p) for p in plan["masked_files"]],
            "command": cmd,
        }
        if backend == "bwrap":
            summary["bwrap_argv"] = build_bwrap_argv(plan, cmd, env)
        print(json.dumps(summary, indent=2))
        return 0

    if backend == "bwrap":
        bwrap_bin = shutil.which("bwrap")
        if not bwrap_bin:
            sys.stderr.write("agent-jail: error: bwrap not found on PATH\n")
            return 1
        argv = build_bwrap_argv(plan, cmd, env)
        os.execvpe(bwrap_bin, argv, env)

    apply_landlock_and_exec(plan, cmd, env)
    return 0


if __name__ == "__main__":
    sys.exit(main())
