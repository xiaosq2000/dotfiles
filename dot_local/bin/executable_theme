#!/usr/bin/env bash
# Switch the colour scheme across every tool at once.
#
# This replaced the `theme/light` branch. Switching used to mean checking out
# another branch, which meant every non-theme commit had to be landed on both
# and they drifted anyway. Now one value in ~/.config/chezmoi/chezmoi.toml
# selects a variant from .chezmoidata/themes-*.toml and `chezmoi apply` rewrites
# every tool's config from it.
#
#   theme                        show the current variant and the alternatives
#   theme rose-pine-dawn         switch and apply
#   theme --dry-run catppuccin-mocha
#                                show what would change without writing
#
# The variant list is not hard-coded here. It used to be, as
# VARIANTS=(main moon dawn), which meant adding a colour scheme required editing
# this script as well as the data, and forgetting to do so made the new variant
# unreachable through the only command anyone uses to reach it.
set -euo pipefail

CONFIG="${CHEZMOI_CONFIG_FILE:-$HOME/.config/chezmoi/chezmoi.toml}"
DRY_RUN=false

die() {
    printf 'theme: %s\n' "$*" >&2
    exit 1
}

# Every lookup goes through chezmoi so that the data stays in one place. Each
# call costs a few milliseconds, which is nothing against the `chezmoi apply`
# that follows.
data() {
    chezmoi execute-template "$1"
}

current_theme() {
    # The generated config is small and machine-written, so a targeted match on
    # the assignment is enough and avoids depending on a TOML parser.
    sed -n 's/^[[:space:]]*theme[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | head -n1
}

variants() {
    data '{{ keys .themes | sortAlpha | join " " }}'
}

usage() {
    local current
    current="$(current_theme)"
    printf 'usage: theme [--dry-run] <variant>\n\n'
    printf 'current: %s\n\n' "${current:-unknown}"
    printf 'available:\n'
    # Grouped by scheme. Every variant covers every tool since starship stopped
    # depending on a per-scheme checkout, but the list stays printed: it is the
    # answer to "what will actually change if I switch", and the next scheme
    # added could reintroduce a gap.
    data '{{ range $scheme, $s := .schemes }}
  {{ $scheme }} — {{ $s.description }}
{{ range $name, $t := $.themes }}{{ if eq $t.scheme $scheme }}    {{ if eq $name $.theme }}*{{ else }} {{ end }} {{ printf "%-22s" $name }} {{ printf "%-5s" $t.appearance }}  {{ $t.description }}
      covers: btop kitty alacritty nvim zathura fzf starship
{{ end }}{{ end }}{{ end }}'
}

while [ $# -gt 0 ]; do
    case "$1" in
    -n | --dry-run)
        DRY_RUN=true
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        die "unknown option: $1"
        ;;
    *)
        break
        ;;
    esac
done

command -v chezmoi >/dev/null 2>&1 || die "chezmoi is not on PATH"
[ -f "$CONFIG" ] || die "chezmoi config not found at $CONFIG; run 'chezmoi init' first"

if [ $# -eq 0 ]; then
    usage
    exit 0
fi

want="$1"
valid=false
for v in $(variants); do
    [ "$v" = "$want" ] && valid=true
done
if [ "$valid" != true ]; then
    printf 'theme: unknown variant %s\n\n' "$want" >&2
    usage >&2
    exit 1
fi

have="$(current_theme)"
[ -n "$have" ] || die "no theme setting found in $CONFIG"

if [ "$DRY_RUN" = true ]; then
    printf 'theme: %s -> %s (dry run)\n\n' "$have" "$want"
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    sed "s/^\([[:space:]]*theme[[:space:]]*=[[:space:]]*\)\"[^\"]*\"/\1\"$want\"/" "$CONFIG" >"$tmp"
    # Two things this line gets right that the old one did not.
    #
    # --config, not CHEZMOI_CONFIG_FILE. chezmoi ignores that variable
    # entirely: only -c/--config selects a config file. So this dry run had
    # been rendering the diff for the theme already in effect, which is to say
    # nothing at all, for as long as the flag has existed.
    #
    # --config-format, because chezmoi infers the format from the file
    # extension and mktemp produces a name with none, which fails with
    # "unknown format". Passing it explicitly beats relying on mktemp
    # --suffix, which is a GNU extension.
    chezmoi --config "$tmp" --config-format toml diff
    exit 0
fi

if [ "$have" = "$want" ]; then
    printf 'theme: already %s\n' "$want"
else
    # Rewrite only the assignment, so the explanatory comments around it stay.
    sed -i "s/^\([[:space:]]*theme[[:space:]]*=[[:space:]]*\)\"[^\"]*\"/\1\"$want\"/" "$CONFIG"
    printf 'theme: %s -> %s\n' "$have" "$want"
fi

chezmoi apply

# Nudge the running programs that can reload without a restart. Each is
# optional: a missing binary or a terminal without remote control enabled is
# not an error, the new colours just arrive with the next start.
if [ -n "${KITTY_WINDOW_ID:-}" ] && command -v kitten >/dev/null 2>&1; then
    kitten @ set-colors --all --configured "$HOME/.config/kitty/current-theme.conf" 2>/dev/null &&
        printf 'theme: reloaded kitty\n' || true
fi

# btop and starship read their config at startup; fzf reads the environment;
# nvim needs a restart when the scheme change also changes which plugin
# provides it, because lazy.nvim installs it on the next start.
printf 'theme: open a new shell for fzf and starship to pick up %s\n' "$want"
