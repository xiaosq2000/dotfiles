#!/usr/bin/env bash
# Install the i-have-adhd skill for whichever agents this machine has.
#
# Next to 20-agent-skills for the same reason it is separate from the tool chain
# script: not gated on the machine's bundles, because adhd.sh checks for each
# agent itself and does nothing where neither is installed. A login node without
# claude or codex pays two `command -v` calls.
#
# Re-runs when adhd.sh changes, so a new machine installs on its first apply and
# an edit here reaches the others on `chezmoi update`. It never passes --update,
# because that would make every apply refetch a marketplace nobody asked it to;
# picking up an upstream change is `~/.sh_utils/setup.d/adhd.sh --update`, by
# hand, on the machine you are sitting at.
# adhd.sh sha256: {{ include "dot_sh_utils/setup.d/executable_adhd.sh" | sha256sum }}

set -eu

exec "$HOME/.sh_utils/setup.d/adhd.sh"
