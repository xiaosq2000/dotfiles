#!/usr/bin/env bash
# Runs what is left of the installers in ~/.sh_utils/setup.d.
#
# Most of that directory has gone. uv, neovim, fzf, lazydocker and luarocks were
# each 30 to 220 lines of "resolve the latest GitHub release, guess the asset
# name for this OS and architecture, download, untar, verify", and conda-forge
# packages all five, so they are bundle entries in .chezmoidata/tools.toml now.
# tpm became a chezmoi external, and zsh.sh went with oh-my-zsh: sheldon and
# ~/.config/sheldon/plugins.toml replaced both the framework and the script that
# cloned its plugins. What remains is the work that is genuinely not a package
# download.
#
# Why this is a wrapper rather than the installers being chezmoi scripts
# themselves. Every script in setup.d locates its UI library relative to its
# own path:
#
#     SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
#     UI_LIB="$SCRIPT_DIR/../lib/ui.sh"
#
# chezmoi executes run_ scripts from a temporary file, so BASH_SOURCE would
# point outside ~/.sh_utils and every one of them would exit with "UI library
# not found". They also have to exist in the target state regardless, because
# .zshrc and .bashrc source ~/.sh_utils/*.sh at every shell start. So chezmoi
# writes them as ordinary files and this script calls them where they land.
#
# The hashes below are what make `run_onchange_` fire: editing any installer
# changes this rendered script, so chezmoi re-runs it.
{{- $m := index .machines .machine -}}
{{- /*
   nodejs: points pnpm's global install at a directory on PATH. Only where the
   machine takes the dev-web bundle, which is what provides pnpm; running it
   elsewhere only printed "pnpm not found on PATH", as it did on sicc.
   rust: everywhere, because its first job is removing cargo copies of tools
   that moved into a pixi bundle and would otherwise shadow them on PATH. It
   installs a toolchain only when RUST_TOOLCHAIN says the machine wants one, and
   exits immediately on a machine with neither cargo nor a request for it.
   typefaces: only where the machine asks for fonts. This one stayed a script
   rather than becoming externals: it installs sixteen families, each with its
   own release-asset naming and its own set of wanted extensions, and every
   machine here has typefaces = false, so a rewrite would be both large and
   untested. See docs/todo.md.
*/ -}}
{{- $setup := list -}}
{{- if has "dev-web" $m.bundles }}{{ $setup = append $setup "nodejs" }}{{ end -}}
{{- $setup = append $setup "rust" -}}
{{- if $m.typefaces }}{{ $setup = append $setup "typefaces" }}{{ end -}}
{{ range $setup }}
# {{ . }}.sh sha256: {{ include (printf "dot_sh_utils/setup.d/executable_%s.sh" .) | sha256sum }}
{{- end }}

set -eu

{{ if not $m.bundles -}}
echo "machine {{ .machine }} selects no bundles; skipping the setup.d tool chain"
exit 0
{{ end -}}

# shellcheck source=/dev/null
. "$HOME/.sh_utils/lib/ui.sh"

SETUP_FAILED=""

# A missing script is an error, not a warning. install.sh used to warn and
# carry on, which is how it pointed at a nonexistent node.sh for months while
# still reporting success.
run_setup() {
    local name="$1"
    local script="$HOME/.sh_utils/setup.d/${name}.sh"

    if [ ! -f "$script" ]; then
        error "setup script not found at $script"
        SETUP_FAILED="$SETUP_FAILED $name"
        return 1
    fi

    info "running $name"
    # RUST_TOOLCHAIN is read by rust.sh; see the note above.
    if RUST_TOOLCHAIN={{ $m.rust }} bash "$script"; then
        success "$name done"
        return 0
    fi

    warning "$name encountered an error"
    SETUP_FAILED="$SETUP_FAILED $name"
    return 1
}

# pixi ran earlier, from 05-pixi.sh, so everything these scripts call is already
# on PATH.
{{ if $setup -}}
for name in {{ $setup | join " " }}; do
    run_setup "$name" || true
done
{{- else -}}
echo "machine {{ .machine }} needs none of the setup.d installers"
{{- end }}

if [ -n "$SETUP_FAILED" ]; then
    error "these setup scripts did not complete:$SETUP_FAILED"
    exit 1
fi
