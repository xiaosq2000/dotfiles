# Reference:
# https://stackoverflow.com/a/29932318/11393911

/*

!README.md

!.pre-commit-config.yaml
!.aider.conf.yml

!.bashrc

# .gitconfig
!.gitignore

!.config/
.config/*

!.config/alacritty/
!.config/alacritty/alacritty.toml
.config/alacritty/themes

!.config/kitty/
.config/kitty/*
!.config/kitty/kitty.conf
!.config/kitty/current-theme.conf

!.config/starship.toml

!.config/tmux/

!.config/zsh/
!.zshrc

!.config/nvim/
#.config/nvim/lazy-lock.json

!.config/zathura/
# TODO: simplify
!.local
.local/*
!.local/bin
.local/bin/*
!.local/bin/ai-privacy
!.local/bin/zathura

!.latexmkrc

!.condarc

# .secrets stays out of this public repo entirely: it is a separate local-only
# repo, never a submodule. Do not re-add a `!.secrets` negation here.
!.sh_utils

!.config/kmonad/

!.config/yazi/

!.config/btop/

!.config/lazygit/

!.config/fcitx5/
# machine-generated cache of every available xkb layout
.config/fcitx5/conf/cached_layouts

# fcitx5 needs its env set before gnome-session starts
!.config/environment.d/

# ...and nothing autostarts it on Ubuntu; other apps drop entries here too, so
# track only ours
!.config/autostart/
.config/autostart/*
!.config/autostart/org.fcitx.Fcitx5.desktop

!.config/themes
!.config/themes/rose-pine/starship

!.config/opencode
.config/opencode/*
!.config/opencode/opencode.json
!.config/opencode/opencode-notifier.json

!.opencode
.opencode/bin

# Single source of truth for user-level agent skills, kept vendor neutral so
# Claude Code, Codex and OpenCode can all share it. ~/.sh_utils/setup.d/agent_skills.sh
# symlinks each skill into ~/.claude/skills and ~/.codex/skills; OpenCode reads
# ~/.agents/skills natively. Only the canonical copies below are tracked, never
# the generated symlinks.
!.agents
.agents/*
!.agents/skills
